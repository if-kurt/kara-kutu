#!/bin/sh
# Kara Kutu G33 — ana hat: G32 (eMMC SALT OKUMA + USB NCM + telnet 2323) + Debian'ı SALT OKUNUR açma.
# eMMC'ye yazma yok: kkdata (userdata, ext4) "ro,noload" bağlanır (journal replay yok); Debian dizini overlay'in
# ALT katmanı, üst katman ve work 256 MiB tmpfs'te. switch_root bu overlay'e. Karta yazma kernel'de de engelli
# (mmc core kk_mmc_filtre + CMD6 beyaz liste + katı mod; disk ro). /dev/mem yok.
# Üst katman (init yazar): maskeler (kk-wifi, kk-charge, kk-clock*, kk-ekran, kk-bootok, timesyncd,
#   systemd-pstore, apt/man-db/dpkg/e2scrub/fstrim zamanlayıcıları, wpa_supplicant), sshd YALNIZ 2222,
#   G37: chrony maskesiz (drift/log üst katmana; rtcsync alt katmanda kapalı, ana hatta RTC sürücüsü yok);
#   usb0'a (10-kk-usb.network drop-in) Gateway=172.16.42.2 (ana makine NAT); DNS alt katmanın resolv.conf'u.
#   hostname kk-anahat-debian, journald volatile + kmsg'ye, sysrq=0, reboot-param=bootloader,
#   systemd RuntimeWatchdogSec=60s (NOWAYOUT kalır), oturum sınırı zamanlayıcısı (DEB_SINIR sn -> reboot bootloader).
# Watchdog devri: initramfs besleyicisi durdurulur, init son kez besler (60 sn bütçe), systemd devralır.
# Debian'a geçilemezse (geri dönüşsüz noktadan önce) init G32 gibi initramfs oturumunda kalır (telnet 2323,
#   OTURUM sn'de reboot bootloader). cmdline kk_oturum= / kk_wd_sinir= / kk_debian_sinir= yalnız KISALTIR;
#   kk_debian=0 Debian'ı atlar (yalnız atlatır). Bunlar cihazın DT bootargs'ında yok (QEMU sınaması).
# G47 S2 (KV3/KV6): pstore bağlandıktan hemen sonra /bin/kk-idle-bekci karar (YALNIZ log; kmsg + pmsg; açma YOK).
#   Üst katmana aynı bekçi + kk-idle-bekci.timer (OnBootSec=120s, aşamalı açma) + kk-idle-durum.timer (10 dk).
# G57 G-1 (öneri): kk_gunluk=1 (yalnız günlük imajın DT bootargs'ı) -> Debian oturum sınırı zamanlayıcısı KURULMAZ; yerine
#   sağlık bekçisi /bin/kk-saglik (kk-saglik.timer 30 sn + 60 sn). kk_gunluk yoksa üst katman G57 E6 init'iyle AYNI
#   (sınır zamanlayıcısı, kk-saglik yok). initramfs oturumu (OTURUM) ve initramfs besleyicisinin sert sınırı (WD_SINIR)
#   iki kipte de aynen (Debian'a geçilemezse eski yol). SP805 (systemd RuntimeWatchdogSec) ve çip WDT'si (çekirdek) aynen.
# G58 G-1 (öneri): G-1K kısa oturum değişkesi. kk_gunluk=1 iken bootargs'ta kk_debian_sinir=<sn> AÇIKÇA verilmişse (G-1K: 1200)
#   oturum sınırı zamanlayıcısı DA kurulur (D1 yerinde) ve kk-saglik aynen kurulur; kk_saglik_gozlem=1 bekçiyi gözlem kipine alır
#   (bekçi okur; eylem yok). Güvenli düşüş: kk_saglik_gozlem=1 verilip kk_debian_sinir verilmemişse sınır DEB_SINIR (1740) ile
#   kurulur (eylemsiz bekçi + sınırsız oturum olmaz). G-1U (kk_debian_sinir yok, gözlem yok) üst katmanı G57 G-1 ile AYNI.
# G59-A (öneri): günlük imaj. kk_gunluk_sinir tavanı 604800 sn (7 gün; alt sınır 3600 aynen). Günlük kipte (GSV=1: yalnız kk_gunluk=1 +
#   geçerli kk_gunluk_sinir + kk_debian_sinir YOK) sınır eylemi NORMAL reboot (`systemctl reboot normal` -> DT mode-normal 0x10 -> bootloader
#   `kernel`'i = ana hattı yeniden açar). systemctl başarısızsa yedek: kk-alan kapat + busybox `reboot -f` (komutsuz RESTART -> kk-reset-nedeni/
#   reboot-mode "normal" -> 0x10; kk-reboot2 yalnız "bootloader" kabul eder). kk_debian_sinir yolu (G-1K, D1 test imajları) ve kk-saglik eylemleri
#   (bootloader) DEĞİŞMEDİ. GSV=0 iken üretilen sınır betiği/birimleri G58-D ile bayt bayt aynıdır.
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
say() { echo "<4>kk: $*" > /dev/kmsg 2>/dev/null || echo "$*"; }
up() { cut -d' ' -f1 /proc/uptime; }
upi() { cut -d. -f1 /proc/uptime; }
rd() { cat "$1" 2>/dev/null; }

IP_DEV=172.16.42.1; MAC_DEV=02:4b:4b:00:00:01; MAC_HOST=02:4b:4b:00:00:02; PORT=2323
OTURUM=840; WD_SINIR=900; DEB_SINIR=1740; DEBIAN=1
# G52 E6 (öneri): kk_alan=1|ro yalnız AÇAR (cihazda yalnız DT bootargs'tan; bootloader eklemez). Yoksa bugünkü davranış aynen.
KKALAN=0; KKAZ=0; KKGUNLUK=0; DSV=0; KKGOZ=0; GSINIR=0; GSV=0; SHEDEF=bootloader; KKWIFI=0; WBEKCI=1; KKZRAM=1
for a in $(cat /proc/cmdline); do
	case $a in
	kk_alan=1) KKALAN=1;;
	kk_alan_az=1) KKAZ=1;;	# G53 (öneri): yazma azaltma; yalnız kk_alan=1 ile birlikte etkili
	kk_alan=ro) KKALAN=ro;;
	kk_oturum=*) v=${a#kk_oturum=}; case $v in ''|*[!0-9]*) ;; *) [ "$v" -ge 30 ] && [ "$v" -lt $OTURUM ] && OTURUM=$v;; esac;;
	kk_wd_sinir=*) v=${a#kk_wd_sinir=}; case $v in ''|*[!0-9]*) ;; *) [ "$v" -ge 60 ] && [ "$v" -lt $WD_SINIR ] && WD_SINIR=$v;; esac;;
	kk_debian_sinir=*) v=${a#kk_debian_sinir=}; case $v in ''|*[!0-9]*) ;; *) [ "$v" -ge 120 ] && [ "$v" -lt $DEB_SINIR ] && DEB_SINIR=$v && DSV=1;; esac;;
	kk_saglik_gozlem=1) KKGOZ=1;;	# G58 G-1K (öneri): yalnız AÇAR; init yalnız sınır kararında kullanır (bekçi kendisi okur)
	kk_wifi.ac=1) KKWIFI=1;;	# G59-C (öneri): Wi-Fi zinciri yalnız AÇAR (çekirdek parametresi ile aynı anahtar; yoksa init Wi-Fi'ye hiç dokunmaz)
	kk_zram=0) KKZRAM=0;;	# G59-L: zram takasi varsayilan ACIK; bu anahtar yalniz KAPATIR
	kk_wifi_bekci=0) WBEKCI=0;;	# G59-C: kalıcı bekçi kapatma (yalnız KAPATIR)
	kk_debian=0) DEBIAN=0;;
	kk_gunluk=1) KKGUNLUK=1;;	# G57 G-1 (öneri): yalnız AÇAR; başka değer = yok
	kk_gunluk_sinir=*) v=${a#kk_gunluk_sinir=}; case $v in ''|*[!0-9]*|0*|???????*) ;; *) [ "$v" -ge 3600 ] && [ "$v" -le 604800 ] && GSINIR=$v;; esac;;	# G59-A (öneri): 3600..604800 sn (7 gün; <= 6 hane, baştaki 0 yok); geçersiz = yok
	esac
done
# G58: oturum sınırı zamanlayıcısı kurulur mu: kk_gunluk yokken her zaman (G57 ile aynı); kk_gunluk=1 iken yalnız açık
#   kk_debian_sinir (G-1K) ya da gözlem (güvenli düşüş) varsa
SINIRK=1; [ $KKGUNLUK = 1 ] && [ $DSV = 0 ] && [ $KKGOZ = 0 ] && SINIRK=0
# G58-D: günlük üst süre. Yalnız kk_gunluk=1 + geçerli kk_gunluk_sinir + kk_debian_sinir YOK (G-1K yolu aynen). Aynı zamanlayıcı yolu: DEB_SINIR=GSINIR.
# G59-A: günlük kipte (GSV=1) sınır eylemi normal reboot (SHEDEF=normal); aksi hâlde bootloader (G58-D'ye kadar her yol).
[ $KKGUNLUK = 1 ] && [ $DSV = 0 ] && [ $GSINIR -gt 0 ] && { SINIRK=1; DEB_SINIR=$GSINIR; GSV=1; SHEDEF=normal; }
echo $OTURUM > /kk-oturum
hostname kk-anahat
ifconfig lo 127.0.0.1 up

say "==== Kara Kutu ana hat (G33: Debian salt okunur overlay; USB NCM; eMMC salt okuma) ===="
say "kernel: $(cut -d' ' -f1-3 /proc/version)"
say "model: $(cat /proc/device-tree/model 2>/dev/null)"
say "cmdline: $(cat /proc/cmdline)"
say "cpu: $(grep -c ^processor /proc/cpuinfo) cekirdek, online=$(cat /sys/devices/system/cpu/online)"
say "bellek: $(grep -E 'MemTotal' /proc/meminfo | tr -s ' ') / $(grep -E 'MemAvailable' /proc/meminfo | tr -s ' ')"
for W in /sys/class/watchdog/watchdog*; do [ -d $W ] && say "watchdog: $(basename $W) $(rd $W/identity) durum=$(rd $W/state) sure=$(rd $W/timeout)s nowayout=$(rd $W/nowayout)"; done
if [ $KKGUNLUK = 1 ]; then KSG=$([ -x /bin/kk-saglik ] && sha256sum /bin/kk-saglik | cut -c1-16 || echo YOK)
	if [ $GSV = 1 ]; then DOT="GUNLUK + gunluk siniri ${DEB_SINIR}s -> reboot normal (saglik bekcisi kk-saglik $KSG $([ $KKGOZ = 1 ] && echo GOZLEM || echo EYLEMLI))"
	elif [ $SINIRK = 1 ]; then DOT="GUNLUK + oturum siniri ${DEB_SINIR}s (G-1K; saglik bekcisi kk-saglik $KSG $([ $KKGOZ = 1 ] && echo GOZLEM || echo EYLEMLI))"
	else DOT="GUNLUK (oturum siniri YOK; saglik bekcisi kk-saglik $KSG)"; fi
else DOT="${DEB_SINIR}s"; fi
say "watchdog open_timeout=$(rd /sys/module/watchdog/parameters/open_timeout)s; init besleyecek, sert sinir ${WD_SINIR}s; initramfs oturumu ${OTURUM}s; debian oturumu $DOT; debian=$DEBIAN"
say "alan (G52 E6 + G53): kk_alan=$KKALAN kk_alan_az=$KKAZ ($([ -x /bin/kk-alan ] && echo "kk-alan $(sha256sum /bin/kk-alan | cut -c1-16)" || echo 'kk-alan yok'))"
say "devmem: $([ -e /dev/mem ] && echo VAR || echo yok)"
RM=$(ls /sys/bus/platform/drivers/syscon-reboot-mode 2>/dev/null | grep -v -e bind -e uevent | tr '\n' ' ')
say "reboot-mode: ${RM:-YOK}"
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
say "pstore: $(ls /sys/fs/pstore 2>/dev/null | tr '\n' ' ')"
# G47 (KV3/KV6): önceki açılışın değerlendirmesi. YALNIZ okuma + log (açma YOK; açma Debian'da 120 sn sonra).
# pstore dosyaları silinmez. Bekçi hatası init'i etkilemez.
[ -x /bin/kk-idle-bekci ] && /bin/kk-idle-bekci karar initramfs > /dev/null 2>&1

# Yalnız QEMU sınama imajında var (cihaz imajında bu dosya YOK): watchdog açılmadan önceki takılma benzetimi.
[ -x /bin/kk-qemu-ek ] && /bin/kk-qemu-ek erken

# --- watchdog besleyici (arka plan); fd kapanmaz, NOWAYOUT. Çocuk "sleep"ler fd 3'ü taşımaz (devir için). ---
(
	# Aygıt yoksa "exec 3>" devtmpfs'te sıradan dosya yaratır; önce karakter aygıtı mı diye bak.
	[ -c /dev/watchdog ] || { say "HATA: /dev/watchdog karakter aygiti yok; besleme yok"; exit 1; }
	exec 3>/dev/watchdog || { say "HATA: /dev/watchdog acilamadi; open_timeout (180 sn) yolu gecerli"; exit 1; }
	say "watchdog: init besliyor (15 sn), sert sinir uptime ${WD_SINIR}s"
	while [ "$(upi)" -lt $WD_SINIR ]; do printf . >&3; sleep 15 3>&-; done
	say "watchdog: SERT SINIR doldu (${WD_SINIR}s); besleme birakildi, reset bekleniyor"
	while :; do sleep 3600 3>&-; done
) &
WDPID=$!

# --- USB NCM gadget + telnetd ---
usb_kur() {
	mount -t configfs configfs /sys/kernel/config 2>/dev/null
	[ -d /sys/kernel/config/usb_gadget ] || { say "HATA: configfs usb_gadget yok"; return 1; }
	i=0; while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
	[ -n "$UDC" ] || { say "HATA: UDC yok (10 sn)"; return 1; }
	say "usb: UDC $UDC (${i} x 0.5 sn beklendi)"
	G=/sys/kernel/config/usb_gadget/kk
	mkdir $G || return 1
	echo 0x1d6b > $G/idVendor
	echo 0x0104 > $G/idProduct
	echo 0x0633 > $G/bcdDevice
	mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409
	echo "KK-ANAHAT" > $G/strings/0x409/serialnumber
	echo "Kara Kutu" > $G/strings/0x409/manufacturer
	echo "kk-anahat G33" > $G/strings/0x409/product
	echo "kk-net" > $G/configs/c.1/strings/0x409/configuration
	echo 250 > $G/configs/c.1/MaxPower
	mkdir $G/functions/ncm.usb0 || { say "HATA: ncm.usb0 olusturulamadi"; return 1; }
	echo $MAC_DEV > $G/functions/ncm.usb0/dev_addr
	echo $MAC_HOST > $G/functions/ncm.usb0/host_addr
	ln -s $G/functions/ncm.usb0 $G/configs/c.1/ || { say "HATA: ncm config'e baglanamadi"; return 1; }
	echo $UDC > $G/UDC || { say "HATA: gadget UDC'ye baglanamadi"; return 1; }
	IFN=$(rd $G/functions/ncm.usb0/ifname)
	[ -n "$IFN" ] && [ -e /sys/class/net/$IFN ] || { say "HATA: ncm arayuzu yok (ifname='$IFN')"; return 1; }
	ifconfig $IFN $IP_DEV netmask 255.255.255.0 up || { say "HATA: $IFN IP alamadi"; return 1; }
	mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
	telnetd -b $IP_DEV:$PORT -l /bin/kk-karsila || { say "HATA: telnetd baslamadi"; return 1; }
	say "usb ag: $IFN $IP_DEV/24 mac=$(rd /sys/class/net/$IFN/address) host_addr=$(rd $G/functions/ncm.usb0/host_addr); telnetd $IP_DEV:$PORT; UDC state $(rd /sys/class/udc/$UDC/state)"
	return 0
}
usb_kur || say "UYARI: USB agi kurulamadi"

# --- eMMC (G31 ile aynı) ---
dev() { for u in /sys/class/block/mmcblk0p*/uevent; do grep -qx "PARTNAME=$1" $u && sed -n 's/^DEVNAME=//p' $u; done; }
# bul <ad>: önce "<ad>", yoksa "<ad>_a". Tam bir eşleşme şart (birden çoksa kullanılmaz). Sonuç BD (aygıt), BA (bulunan ad).
bul() {
	BD=; BA=
	for a in "$1" "$1_a"; do
		d=$(dev "$a"); c=$(echo "$d" | grep -c .)
		[ "$c" -gt 1 ] && { say "UYARI: '$a' adinda $c bolum; kullanilmadi"; return 1; }
		[ "$c" -eq 1 ] && { BD=$d; BA=$a; return 0; }
	done
	return 1
}
i=0; while [ ! -e /sys/block/mmcblk0 ] && [ $i -lt 30 ]; do sleep 0.5; i=$((i + 1)); done
if [ ! -e /sys/block/mmcblk0 ]; then
	say "HATA: mmcblk0 yok (15 sn)"
	DEBIAN=0
else
	C=$(ls -d /sys/class/mmc_host/mmc*/mmc*:* 2>/dev/null | head -1)
	say "mmc kart: $(basename "$C") ad=$(rd $C/name) tur=$(rd $C/type) uretici=$(rd $C/manfid) tarih=$(rd $C/date) rev=$(rd $C/rev)"
	say "mmcblk0: $(cat /sys/block/mmcblk0/size) sektor, ro=$(cat /sys/block/mmcblk0/ro), blockdev --getro=$(blockdev --getro /dev/mmcblk0 2>&1)"
	# ios yalnız host->ios'u yazdırır, karta komut göndermez. debugfs yalnız bunun için bağlanır ve hemen ayrılır.
	: > /kk-ios.txt
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	k=0
	for f in /sys/kernel/debug/mmc*/ios; do
		[ -r "$f" ] || continue
		h=${f%/ios}; h=${h##*/}; k=$((k + 1))
		while read -r l; do say "ios $h: $l"; echo "$h: $l" >> /kk-ios.txt; done < "$f"
	done
	umount /sys/kernel/debug 2>/dev/null
	say "debugfs ayrildi: $(grep -c ' /sys/kernel/debug ' /proc/mounts) bagli"
	[ $k -gt 0 ] || say "ios: okunamadi (debugfs/mmc ios yok)"
	n=0
	for d in /sys/class/block/mmcblk0p*; do
		[ -e "$d/partition" ] || continue
		n=$((n + 1))
		say "bolum $(basename $d) $(sed -n 's/^PARTNAME=//p' $d/uevent) start=$(cat $d/start) size=$(cat $d/size)"
	done
	say "bolum sayisi: $n"
	if bul vendor; then
		V=$BD
		N=$(( $(cat /sys/class/block/$V/size) / 2048 )); [ $N -gt 256 ] && N=256
		t1=$(up); dd if=/dev/$V of=/dev/null bs=1M count=$N iflag=direct 2>/dev/null; t2=$(up)
		say "hiz: vendor (ad=$BA) /dev/$V $N MiB O_DIRECT okuma $(awk -v a=$t1 -v b=$t2 -v n=$N 'BEGIN{d=b-a; printf "%.2f sn = %.1f MB/s", d, n*1.048576/d}')"
	else
		say "hiz: vendor bolumu yok (ne vendor ne vendor_a); hiz testi yapilmadi"
	fi
	for p in kernel erecovery_kernel nvme misc vendor; do
		bul $p || { say "sha $p: bolum yok (ne $p ne ${p}_a)"; continue; }
		D=$BD
		t1=$(up); s=$(sha256sum /dev/$D | cut -c1-64); t2=$(up)
		say "sha $p (ad=$BA) /dev/$D $(( $(cat /sys/class/block/$D/size) * 512 )) B $s ($(awk -v a=$t1 -v b=$t2 'BEGIN{printf "%.1f", b-a}') sn)"
	done
fi
# --- G34: HS200 geri düşüş gösterimi (yalnız cmdline kk_hs200_dusus_testi; hiçbir bölüm bağlı değilken) ---
ios_oku() {	# ios_oku <etiket>: debugfs yalnız ios için bağlanır, ayrılır
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	for f in /sys/kernel/debug/mmc*/ios; do
		[ -r "$f" ] || continue
		say "ios[$1] ${f#/sys/kernel/debug/}: $(grep -E 'actual clock|bus width|timing spec|signal voltage' $f | tr -s '\t ' ' ' | tr '\n' '|')"
	done
	umount /sys/kernel/debug 2>/dev/null
}
mmc_bekle() {	# mmc_bekle <var|yok> : en çok 30 sn
	i=0
	while [ $i -lt 60 ]; do
		if [ "$1" = var ]; then [ -e /sys/block/mmcblk0 ] && return 0; else [ -e /sys/block/mmcblk0 ] || return 0; fi
		sleep 0.5; i=$((i + 1))
	done
	return 1
}
hs200_dusus_testi() {
	grep -qw kk_hs200_dusus_testi /proc/cmdline || return 0
	[ -e /sys/block/mmcblk0 ] || { say "hs200 dusus testi: mmcblk0 yok; atlandi"; return 1; }
	# /sys/block/mmcblk0/device = kartın kendisi (mmcblk sürücüsü bağlı); denetleyici onun üstünde (mmc_host/mmcN'in ebeveyni)
	X=$(readlink -f /sys/block/mmcblk0/device); X=${X%/*}
	while [ "$X" != / ] && [ ! -e "$X/driver" ]; do X=${X%/*}; done
	[ -e "$X/driver" ] || { say "hs200 dusus testi: denetleyici bulunamadi"; return 1; }
	D=${X##*/}; DRV=$(readlink -f $X/driver); P=/sys/module/sdhci_of_dwcmshc/parameters/kk_tuning_hata
	for adim in dusus geri; do
		v=1; [ $adim = geri ] && v=0
		[ -w $P ] && echo $v > $P
		say "hs200 dusus testi [$adim]: $D (${DRV##*/}) unbind/bind; kk_tuning_hata=$(cat $P 2>/dev/null || echo yok)"
		echo $D > $DRV/unbind; mmc_bekle yok || say "UYARI: mmcblk0 unbind sonrasi kaybolmadi"
		echo $D > $DRV/bind; mmc_bekle var || { say "HATA: hs200 dusus testi [$adim]: mmcblk0 30 sn'de gelmedi"; return 1; }
		ios_oku "$adim"
		bul misc && say "hs200 dusus testi [$adim]: sha misc (ad=$BA) $(sha256sum /dev/$BD | cut -c1-64)"
	done
	say "hs200 dusus testi bitti; $(dmesg | grep -c 'kk: HS200 .* basarisiz') geri dusus satiri"
}
[ -e /sys/block/mmcblk0 ] && hs200_dusus_testi

B=$(dmesg | grep -c 'kk: mmc write blocked: ')
say "mmc write blocked sayisi: $B"
dmesg | grep -v '\] kk: ' | grep -E 'mmc|sdhci|dwcmshc|kk: mmc' | while read -r l; do say "dmesg: $l"; done
[ -x /bin/kk-qemu-ek ] && /bin/kk-qemu-ek son
say "eMMC salt okuma bitti (up=$(up)s)"

# --- Debian: salt okunur overlay hazırlığı (geri dönülebilir) ---
Y=/kk/yeni
ust_yaz() {
	E=$Y/etc
	mkdir -p $E/systemd/system/timers.target.wants $E/systemd/system/multi-user.target.wants \
		$E/systemd/system.conf.d $E/systemd/journald.conf.d $E/ssh/sshd_config.d $E/tmpfiles.d $E/sysctl.d || return 1
	for u in kk-wifi.service kk-charge.service kk-clock.service kk-clock-save.service kk-clock-save.timer \
		kk-ekran.service kk-bootok.service systemd-timesyncd.service \
		systemd-pstore.service apt-daily.timer apt-daily-upgrade.timer man-db.timer dpkg-db-backup.timer \
		e2scrub_all.timer e2scrub_reap.service fstrim.timer wpa_supplicant@wlan0.service wpa_supplicant.service; do
		rm -f $E/systemd/system/$u; ln -s /dev/null $E/systemd/system/$u || return 1
	done
	printf '%s\n' "# Kara Kutu G33 ana hat: YALNIZ 2222 (4.9 Debian 22'de; karismasin)" "Port 2222" > $E/ssh/sshd_config.d/zz-kk-anahat.conf
	# G34 (bakımcı onayı, entropi (a)): CRNG ~126 sn'de hazır; sshd -t getrandom'da bekler -> başlatma süresi 300 sn
