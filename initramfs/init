debian_hazirla() {
	[ $DEBIAN = 1 ] || { say "debian: atlandi (kk_debian=0 ya da eMMC yok)"; return 1; }
	bul userdata || { say "debian: userdata bolumu yok; initramfs oturumunda kaliniyor"; return 1; }
	UD=$BD
	BI=$(blkid /dev/$UD 2>/dev/null)
	case "$BI" in *'LABEL="kkdata"'*'TYPE="ext4"'*|*'TYPE="ext4"'*'LABEL="kkdata"'*) ;;
		*) say "debian: /dev/$UD (ad=$BA) kkdata/ext4 degil ('$BI'); baglanmadi"; return 1;; esac
	mkdir -p /kk/data /kk/ust $Y
	# Süperblok (ofset 1024) s_feature_incompat (+0x60, LE32); bit 0x4 = RECOVER (needs_recovery). Yalnız okuma.
	INC=$(dd if=/dev/$UD bs=1 skip=1120 count=4 2>/dev/null | hexdump -e '1/4 "%08x"')
	case "$INC" in [0-9a-f]*) [ $(( 0x$INC & 4 )) -ne 0 ] && NR=evet || NR=hayir;; *) NR=okunamadi;; esac
	say "debian: kkdata suberblok incompat=0x$INC needs_recovery=$NR (noload ile journal yuklenmez, geri oynatilmaz)"
	mount -t ext4 -o ro,noload /dev/$UD /kk/data || { say "HATA: debian: /dev/$UD ro,noload baglanamadi"; return 1; }
	say "debian: /dev/$UD (ad=$BA) kkdata ext4 -> /kk/data: $(grep ' /kk/data ' /proc/mounts | cut -d' ' -f4)"
	A=/kk/data/kk/os/debian
	# /sbin/init mutlak symlink (-> /lib/systemd/systemd); initramfs'te çözülemez, yalnız varlığına bakılır.
	if [ ! -x $A/usr/lib/systemd/systemd ] || ! { [ -L $A/sbin/init ] || [ -e $A/sbin/init ]; }; then
		say "HATA: debian: $A'da systemd/init yok"; umount /kk/data; return 1
	fi
	mount -t tmpfs -o size=256m,mode=0755 kk-ust /kk/ust && mkdir -p /kk/ust/upper /kk/ust/work || { say "HATA: debian: ust tmpfs"; umount /kk/data; return 1; }
	mount -t overlay -o lowerdir=$A,upperdir=/kk/ust/upper,workdir=/kk/ust/work kk-kok $Y || {
		say "HATA: debian: overlay baglanamadi"; umount /kk/ust; umount /kk/data; return 1; }
	ust_yaz || { say "HATA: debian: ust katman yazilamadi"; umount $Y; umount /kk/ust; umount /kk/data; return 1; }
	# Yalnız QEMU sınama imajında var (cihaz imajında bu dosya YOK): E6 sınama birimleri + QEMU geometrisi (KK_*).
	[ -x /bin/kk-qemu-e6 ] && /bin/kk-qemu-e6 ust $Y
	for d in data dev proc sys run; do mkdir -p $Y/$d; done
	say "debian: overlay hazir: $(grep ' /kk/yeni ' /proc/mounts | cut -d' ' -f1-4)"
	say "debian: ust katman: $(cd /kk/ust/upper && find . -type f -o -type l | tr '\n' ' ')"
	return 0
}
debian_gec() {
	# GERİ DÖNÜŞSÜZ: hata olursa reboot bootloader (normal reboot ana hatta açar).
	gecfail() { say "HATA: $1; switch_root yapilmiyor, reboot bootloader"; sync; /bin/kk-reboot2 bootloader; while :; do sleep 60; done; }
	killall telnetd 2>/dev/null
	kill $WDPID 2>/dev/null
	i=0; while [ $i -lt 40 ]; do
		if ( exec 3>/dev/watchdog && printf . >&3 ) 2>/dev/null; then break; fi
		sleep 0.5; i=$((i + 1))
	done
	if [ $i -ge 40 ]; then say "UYARI: watchdog son besleme yapilamadi (acik fd?)"; else say "watchdog: initramfs besleyici durdu; son besleme (bekleme ${i} x 0.5 sn); systemd 60 sn icinde devralmali"; fi
	say "debian: /data (ro) /dev /proc /sys tasiniyor; exec switch_root $Y /sbin/init (up=$(up)s)"
	mount --move /kk/data $Y/data || gecfail "mount --move /kk/data"
	mount --move /dev $Y/dev || gecfail "mount --move /dev"
	mount --move /proc $Y/proc || gecfail "mount --move /proc"
	mount --move /sys $Y/sys || gecfail "mount --move /sys"
	exec switch_root $Y /sbin/init
	echo "<3>kk: HATA: switch_root dondu" > $Y/dev/kmsg 2>/dev/null
	/bin/kk-reboot2 bootloader
}
if debian_hazirla; then
	[ "$$" = 1 ] || { say "HATA: PID 1 degil; debian'a gecilmiyor"; }
	[ "$$" = 1 ] && debian_gec
