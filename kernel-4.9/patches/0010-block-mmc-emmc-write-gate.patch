diff --git a/include/linux/kk-emmc-kapi.h b/include/linux/kk-emmc-kapi.h
new file mode 100644
index 000000000..e66b17a09
--- /dev/null
+++ b/include/linux/kk-emmc-kapi.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Kara Kutu G63: 4.9 eMMC yazma kapısı — çekirdek içi arayüz (kancalar). Mantık: block/kk-emmc-kapi.h */
+#ifndef _LINUX_KK_EMMC_KAPI_H
+#define _LINUX_KK_EMMC_KAPI_H
+
+#include <linux/types.h>
+
+struct bio;
+struct gendisk;
+struct mmc_host;
+struct mmc_card;
+struct mmc_request;
+
+enum { KK_KAPI_ROL_ANA = 1, KK_KAPI_ROL_DIGER = 2 };	/* DIGER: boot0/boot1/RPMB */
+
+#ifdef CONFIG_KK_EMMC_KAPI
+void kk_kapi_disk_kayit(struct gendisk *disk, int rol);
+void kk_kapi_gpt_denetle(struct gendisk *disk);		/* süreç bağlamı; mmc_blk_probe sonu */
+bool kk_kapi_bio_red(struct bio *bio);			/* true = reddet (bi_error=-EPERM) */
+int kk_kapi_mmc_istek(struct mmc_host *host, struct mmc_request *mrq);	/* 0 ya da -EPERM */
+int kk_kapi_cmd6(struct mmc_card *card, u8 set, u8 index, u8 value);	/* 0 ya da -EPERM */
+int kk_kapi_cmd6_direkt(struct mmc_card *card, u8 index, u8 value);	/* mmc_switch_irq_safe */
+int kk_kapi_ioctl_red(void);				/* -EPERM + sayaç */
+void kk_kapi_host_ayar(struct mmc_host *host);		/* CMDQ + packed kapat */
+#else
+static inline void kk_kapi_disk_kayit(struct gendisk *disk, int rol) { }
+static inline void kk_kapi_gpt_denetle(struct gendisk *disk) { }
+static inline bool kk_kapi_bio_red(struct bio *bio) { return false; }
+static inline int kk_kapi_mmc_istek(struct mmc_host *h, struct mmc_request *m) { return 0; }
+static inline int kk_kapi_cmd6(struct mmc_card *c, u8 s, u8 i, u8 v) { return 0; }
+static inline int kk_kapi_cmd6_direkt(struct mmc_card *c, u8 i, u8 v) { return 0; }
+static inline int kk_kapi_ioctl_red(void) { return 0; }
+static inline void kk_kapi_host_ayar(struct mmc_host *host) { }
+#endif
+
+#endif
