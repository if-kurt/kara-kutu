diff --git a/block/kk-emmc-kapi.c b/block/kk-emmc-kapi.c
new file mode 100644
index 000000000..bed8e32f3
--- /dev/null
+++ b/block/kk-emmc-kapi.c
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Kara Kutu G63: 4.9 eMMC yazma kapısı (çekirdek yapıştırıcısı). Karar mantığı kk-emmc-kapi.h'da (saf).
+ * Başlangıç KAPALI; GPT doğrulanınca ACIK; uymazsa kalıcı KAPALI. Red: -EPERM, panik yok, sayaç + hız sınırlı log.
+ * Katmanlar: B blok (blk-core), A mmc core (istek + CMD6 + ioctl), C CMDQ/packed kapatma.
+ * sysfs: /sys/kernel/kk_emmc_kapi/{durum,profil,red_bio,red_mmc,red_cmd6,red_ioctl,son_red,daralt}
+ */
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/genhd.h>
+#include <linux/blkdev.h>
+#include <linux/bio.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/card.h>
+#include <linux/mmc/core.h>
+#include <linux/mmc/mmc.h>
+#include <linux/kk-emmc-kapi.h>
+#include "kk-emmc-kapi.h"
+
+#define KK_DISK_MAX	8
+
+static struct gendisk *kk_diskler[KK_DISK_MAX];
+static int kk_roller[KK_DISK_MAX];
+static int kk_disk_say;
+
+static struct kk_kapi_durum kd;			/* durum en son yayımlanır (smp_store_release) */
+static int kk_etkin_profil;			/* 1..3; daralt ile 2 -> 3 */
+static DEFINE_MUTEX(kk_kilit);
+static atomic_long_t red_bio, red_mmc, red_cmd6, red_ioctl;
+static char son_red[96];
+static unsigned long log_son;
+static unsigned int log_say;
+static u64 sil_bas, sil_son;
+static bool sil_bas_ok, sil_son_ok;
+
+static bool kk_log_hak(void)
+{
+	if (log_say < 5) { log_say++; log_son = jiffies; return true; }
+	if (time_after(jiffies, log_son + 30 * HZ)) { log_son = jiffies; return true; }
+	return false;
+}
+
+static void kk_red_not(const char *tur, u64 a, u64 b)
+{
+	snprintf(son_red, sizeof(son_red), "%s %llu %llu", tur, (unsigned long long)a, (unsigned long long)b);
+	if (kk_log_hak())
+		pr_warn("kk-emmc-kapi: RED %s sektor/arg=%llu adet/deger=%llu (durum=%d profil=%d)\n", tur,
+			(unsigned long long)a, (unsigned long long)b, smp_load_acquire(&kd.durum), kk_etkin_profil);
+}
+
+static int kk_disk_rol(struct gendisk *d)
+{
+	int i;
+
+	for (i = 0; i < kk_disk_say; i++)
+		if (kk_diskler[i] == d)
+			return kk_roller[i];
+	return 0;
+}
+
+void kk_kapi_disk_kayit(struct gendisk *disk, int rol)
+{
+	if (kk_disk_say < KK_DISK_MAX) {
+		kk_diskler[kk_disk_say] = disk;
+		kk_roller[kk_disk_say] = rol;
+		smp_wmb();
+		kk_disk_say++;
+	}
+}
+
+static bool kk_yazma_ok(u64 sektor, u64 adet)
+{
+	if (smp_load_acquire(&kd.durum) != KK_KAPI_ACIK)
+		return false;
+	return kk_kapi_yazma_izinli(&kd, READ_ONCE(kk_etkin_profil), sektor, adet);
+}
+
+void kk_kapi_gpt_denetle(struct gendisk *disk)
+{
+	struct kk_kapi_gpt *g;
+	struct kk_kapi_durum yeni;
+	struct disk_part_iter pit;
+	struct hd_struct *p;
+	int n = 0, r;
+
+	g = kcalloc(128, sizeof(*g), GFP_KERNEL);
+	mutex_lock(&kk_kilit);
+	if (!g || kd.durum != KK_KAPI_YOK)
+		goto out;
+	disk_part_iter_init(&pit, disk, 0);
+	while ((p = disk_part_iter_next(&pit))) {
+		if (n >= 128) { n = 129; break; }
+		g[n].no = p->partno;
+		g[n].bas = p->start_sect;
+		g[n].boy = p->nr_sects;
+		if (p->info)
+			strlcpy(g[n].ad, p->info->volname, sizeof(g[n].ad));
+		n++;
+	}
+	disk_part_iter_exit(&pit);
+	r = kk_kapi_gpt_dogrula(CONFIG_KK_EMMC_KAPI_PROFIL, g, n, (u64)get_capacity(disk), &yeni);
+	kk_etkin_profil = yeni.profil;
+	memcpy(&kd.a, &yeni.a, sizeof(kd.a));
+	kd.n = yeni.n;
+	kd.profil = yeni.profil;
+	kd.neden = yeni.neden;
+	smp_store_release(&kd.durum, r == 0 ? KK_KAPI_ACIK : KK_KAPI_KAPALI);
+	if (r == 0)
+		pr_info("kk-emmc-kapi: ACIK profil %d (GPT %d bolum, kapasite %llu)\n", yeni.profil, n,
+			(unsigned long long)get_capacity(disk));
+	else
+		pr_err("kk-emmc-kapi: KAPALI (tum yazma red): %s (GPT %d bolum)\n", yeni.neden, n);
+out:
+	mutex_unlock(&kk_kilit);
+	kfree(g);
+}
+
+/* ---- Katman B: blok ---- */
+bool kk_kapi_bio_red(struct bio *bio)
+{
+	int rol;
+	u64 sektor, adet;
+
+	if (!bio->bi_bdev || !bio->bi_bdev->bd_disk)
+		return false;
+	rol = kk_disk_rol(bio->bi_bdev->bd_disk);
+	if (!rol)
+		return false;
+	switch (bio_op(bio)) {
+	case REQ_OP_WRITE:
+	case REQ_OP_DISCARD:
+	case REQ_OP_SECURE_ERASE:
+	case REQ_OP_WRITE_SAME:
+		break;
+	default:
+		return false;
+	}
+	adet = bio_sectors(bio);
+	if (!adet)
+		return false;
+	sektor = bio->bi_iter.bi_sector;
+	if (rol == KK_KAPI_ROL_ANA && kk_yazma_ok(sektor, adet))
+		return false;
+	atomic_long_inc(&red_bio);
+	kk_red_not(rol == KK_KAPI_ROL_ANA ? "bio" : "bio-boot/rpmb", sektor, adet);
+	return true;
+}
+
+/* ---- Katman A: mmc ---- */
+static bool kk_mmc_karti(struct mmc_card *card)
+{
+	return card && mmc_card_mmc(card);
+}
+
+static int kk_cmd6_dene(struct mmc_card *card, u32 set, u32 index, u32 value)
+{
+	if (kk_kapi_cmd6_izinli(set, index, value, card->ext_csd.part_config))
+		return 0;
+	atomic_long_inc(&red_cmd6);
+	kk_red_not("cmd6", index, value);
+	return -EPERM;
+}
+
+int kk_kapi_cmd6(struct mmc_card *card, u8 set, u8 index, u8 value)
+{
+	if (!kk_mmc_karti(card))
+		return 0;
+	return kk_cmd6_dene(card, set, index, value);
+}
+
+int kk_kapi_cmd6_direkt(struct mmc_card *card, u8 index, u8 value)
+{
+	/* send_cmd_direct yolu yalnız önbellek boşaltma için kullanılır */
+	if (!kk_mmc_karti(card))
+		return 0;
+	if (index == KK_E_FLUSH_CACHE && value == 1)
+		return 0;
+	atomic_long_inc(&red_cmd6);
+	kk_red_not("cmd6-direkt", index, value);
+	return -EPERM;
+}
+
+int kk_kapi_mmc_istek(struct mmc_host *host, struct mmc_request *mrq)
+{
+	struct mmc_card *card = host->card;
+	struct mmc_command *c = mrq->cmd;
+	u64 adet, bas, son;
+	u32 a;
+
+	if (!kk_mmc_karti(card))
+		return 0;
+	switch (kk_kapi_opkod_sinif(c->opcode)) {
+	case KK_OP_GEC:
+		return 0;
+	case KK_OP_SILARA:
+		if (c->opcode == 35) { sil_bas = c->arg; sil_bas_ok = true; }
+		else { sil_son = c->arg; sil_son_ok = true; }
+		return 0;
+	case KK_OP_YAZ:
+		adet = mrq->data ? mrq->data->blocks : 0;
+		if (!(card->ext_csd.part_config & 7) && mmc_card_blockaddr(card) && kk_yazma_ok(c->arg, adet))
+			return 0;
+		break;
+	case KK_OP_SIL:
+		bas = sil_bas; son = sil_son;
+		if (sil_bas_ok && sil_son_ok && !(card->ext_csd.part_config & 7) && son >= bas &&
+		    mmc_card_blockaddr(card) && kk_yazma_ok(bas, son - bas + 1)) {
+			sil_bas_ok = sil_son_ok = false;
+			return 0;
+		}
+		sil_bas_ok = sil_son_ok = false;
+		break;
+	case KK_OP_SW:
+		a = c->arg;
+		if (((a >> 24) & 3) == 3 && kk_cmd6_dene(card, a & 7, (a >> 16) & 0xff, (a >> 8) & 0xff) == 0)
+			return 0;
+		return -EPERM;
+	default:
+		break;
+	}
+	atomic_long_inc(&red_mmc);
+	kk_red_not("mmc-cmd", c->opcode, c->arg);
+	return -EPERM;
+}
+
+int kk_kapi_ioctl_red(void)
+{
+	atomic_long_inc(&red_ioctl);
+	kk_red_not("ioctl", 0, 0);
+	return -EPERM;
+}
+
+/* ---- Katman C ---- */
+void kk_kapi_host_ayar(struct mmc_host *host)
+{
+	/* CMDQ motoru host->ops->request'i atlar; packed tek başlık altında çok adresli yazar. İkisi de kapalı. */
+	host->caps2 &= ~(MMC_CAP2_CMD_QUEUE | MMC_CAP2_PACKED_CMD);
+}
+
+/* ---- sysfs ---- */
+static ssize_t durum_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	int d = smp_load_acquire(&kd.durum);
+
+	return sprintf(b, "%s%s%s\n", d == KK_KAPI_ACIK ? "ACIK" : d == KK_KAPI_KAPALI ? "KAPALI" : "YOK",
+		       kd.neden ? " " : "", kd.neden ? kd.neden : "");
+}
+static ssize_t profil_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	return sprintf(b, "%d\n", READ_ONCE(kk_etkin_profil));
+}
+static ssize_t red_bio_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	return sprintf(b, "%ld\n", atomic_long_read(&red_bio));
+}
+static ssize_t red_mmc_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	return sprintf(b, "%ld\n", atomic_long_read(&red_mmc));
+}
+static ssize_t red_cmd6_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	return sprintf(b, "%ld\n", atomic_long_read(&red_cmd6));
+}
+static ssize_t red_ioctl_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	return sprintf(b, "%ld\n", atomic_long_read(&red_ioctl));
+}
+static ssize_t son_red_show(struct kobject *k, struct kobj_attribute *a, char *b)
+{
+	return sprintf(b, "%s\n", son_red);
+}
+/* tek yönlü: profil 2 -> 3 (yalnız p68). Başka değer/durum: -EINVAL. */
+static ssize_t daralt_store(struct kobject *k, struct kobj_attribute *a, const char *b, size_t n)
+{
+	int r = -EINVAL;
+
+	if (n < 1 || b[0] != '1')
+		return -EINVAL;
+	mutex_lock(&kk_kilit);
+	if (kd.durum == KK_KAPI_ACIK && kk_etkin_profil == 2) {
+		WRITE_ONCE(kk_etkin_profil, 3);
+		pr_info("kk-emmc-kapi: profil 2 -> 3 (yalnizca userdata)\n");
+		r = n;
+	}
+	mutex_unlock(&kk_kilit);
+	return r;
+}
+
+static struct kobj_attribute a_durum = __ATTR_RO(durum);
+static struct kobj_attribute a_profil = __ATTR_RO(profil);
+static struct kobj_attribute a_red_bio = __ATTR_RO(red_bio);
+static struct kobj_attribute a_red_mmc = __ATTR_RO(red_mmc);
+static struct kobj_attribute a_red_cmd6 = __ATTR_RO(red_cmd6);
+static struct kobj_attribute a_red_ioctl = __ATTR_RO(red_ioctl);
+static struct kobj_attribute a_son_red = __ATTR_RO(son_red);
+static struct kobj_attribute a_daralt = __ATTR(daralt, 0200, NULL, daralt_store);
+static struct attribute *kk_attrs[] = {
+	&a_durum.attr, &a_profil.attr, &a_red_bio.attr, &a_red_mmc.attr, &a_red_cmd6.attr,
+	&a_red_ioctl.attr, &a_son_red.attr, &a_daralt.attr, NULL,
+};
+static const struct attribute_group kk_grup = { .attrs = kk_attrs };
+
+static int __init kk_kapi_init(void)
+{
+	struct kobject *k = kobject_create_and_add("kk_emmc_kapi", kernel_kobj);
+
+	if (k && sysfs_create_group(k, &kk_grup))
+		pr_warn("kk-emmc-kapi: sysfs olusturulamadi\n");
+	return 0;
+}
+late_initcall(kk_kapi_init);
diff --git a/block/kk-emmc-kapi.h b/block/kk-emmc-kapi.h
new file mode 100644
index 000000000..3d8648df2
--- /dev/null
+++ b/block/kk-emmc-kapi.h
@@ -0,0 +1,210 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Kara Kutu G63: 4.9 eMMC yazma kapısı — SAF karar mantığı (çekirdek tipine bağlı değil;
+ * kullanıcı-uzayı birim takımı da bu dosyayı derler: work/g63/v52/test/).
+ *
+ * Kimlik: GPT'den (ad, no, başlangıç, boy) + kapasite + bölüm sayısı. Tutmazsa kapı KAPALI (tüm yazma red).
+ * Profil 1 = v5.2 {p68, p40}; 2 = v5.2e {p68, p43, misc[0,8), rrecord[0,8)}; 3 = Debian çalışma {p68}.
+ */
+#ifndef KK_EMMC_KAPI_H
+#define KK_EMMC_KAPI_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/string.h>
+#else
+#include <stdint.h>
+#include <string.h>
+typedef uint64_t u64;
+typedef uint32_t u32;
+typedef uint8_t u8;
+#endif
+
+#define KK_KAPI_KART_SEKTOR	244277248ULL
+#define KK_KAPI_BOLUM_SAY	68
+#define KK_KAPI_ADLIK		40
+
+enum { KK_KAPI_YOK = 0, KK_KAPI_ACIK = 1, KK_KAPI_KAPALI = 2 };
+
+struct kk_kapi_gpt {			/* diskten okunan bölüm */
+	char ad[KK_KAPI_ADLIK];
+	u32 no;
+	u64 bas;			/* mutlak sektör */
+	u64 boy;
+};
+
+struct kk_kapi_bek {			/* beklenen bölüm (gömülü tablo) */
+	const char *ad;
+	u32 no;
+	u64 bas, boy;
+	u64 yaz_boy;			/* izinli ilk N sektör (0 = bölümün tamamı) */
+	u8 maske;			/* bit0 profil 1, bit1 profil 2, bit2 profil 3 */
+};
+
+/* Kaynak: ana hat G44 günlüğü (work/g44/b/pstore1/dmesg.txt:292-340) */
+static const struct kk_kapi_bek kk_kapi_tablo[] = {
+	{ "misc",             24,   686080ULL,     4096ULL,         8, 0x02 },
+	{ "rrecord",          26,   722944ULL,    32768ULL,         8, 0x02 },
+	{ "erecovery_kernel", 40,   937984ULL,    49152ULL,         0, 0x01 },
+	{ "kernel",           43,  1085440ULL,    49152ULL,         0, 0x02 },
+	{ "userdata",         68, 16826368ULL, 227450880ULL,        0, 0x07 },
+};
+#define KK_KAPI_TABLO_SAY ((int)(sizeof(kk_kapi_tablo) / sizeof(kk_kapi_tablo[0])))
+
+struct kk_kapi_aralik { u64 bas, boy; u8 maske; };
+
+struct kk_kapi_durum {
+	int durum;			/* KK_KAPI_* */
+	int profil;			/* 1..3 */
+	int n;
+	struct kk_kapi_aralik a[KK_KAPI_TABLO_SAY];
+	const char *neden;		/* KAPALI ise sebep */
+};
+
+/* ad eşleşmesi: tam ya da sonunda "_a" (ana hat ham GPT adı; 4.9 gizleyebilir) */
+static inline int kk_kapi_ad_esle(const char *ad, const char *bek)
+{
+	size_t n = strlen(bek);
+
+	if (strncmp(ad, bek, n) != 0)
+		return 0;
+	return ad[n] == '\0' || (ad[n] == '_' && ad[n + 1] == 'a' && ad[n + 2] == '\0');
+}
+
+static inline int kk_kapi_kesisir(u64 b1, u64 n1, u64 b2, u64 n2)
+{
+	return b1 < b2 + n2 && b2 < b1 + n1;
+}
+
+/*
+ * GPT doğrulama. gpt[0..n): diskteki TÜM bölümler. 0 = açık, <0 = kapalı (d->neden dolu).
+ * Koşullar: kapasite, sayı == 68, beklenen beş bölümün hepsi (ad, no, bas, boy) birebir ve tek,
+ * beklenen aralıklarla kesişen başka bölüm yok, yinelenen ad yok.
+ */
+static inline int kk_kapi_gpt_dogrula(int profil, const struct kk_kapi_gpt *gpt, int n,
+				      u64 kapasite, struct kk_kapi_durum *d)
+{
+	int i, j, bul;
+
+	memset(d, 0, sizeof(*d));
+	d->profil = profil;
+	d->durum = KK_KAPI_KAPALI;
+	if (profil < 1 || profil > 2) { d->neden = "profil"; return -1; }
+	if (kapasite != KK_KAPI_KART_SEKTOR) { d->neden = "kapasite"; return -1; }
+	if (n != KK_KAPI_BOLUM_SAY) { d->neden = "bolum sayisi"; return -1; }
+	for (i = 0; i < KK_KAPI_TABLO_SAY; i++) {
+		const struct kk_kapi_bek *b = &kk_kapi_tablo[i];
+
+		bul = 0;
+		for (j = 0; j < n; j++) {
+			if (kk_kapi_ad_esle(gpt[j].ad, b->ad)) {
+				if (bul) { d->neden = "yinelenen ad"; return -1; }
+				bul = 1;
+				if (gpt[j].no != b->no) { d->neden = "no"; return -1; }
+				if (gpt[j].bas != b->bas) { d->neden = "baslangic"; return -1; }
+				if (gpt[j].boy != b->boy) { d->neden = "boy"; return -1; }
+			}
+		}
+		if (!bul) { d->neden = "eksik bolum"; return -1; }
+		for (j = 0; j < n; j++) {
+			if (gpt[j].no != b->no &&
+			    kk_kapi_kesisir(gpt[j].bas, gpt[j].boy, b->bas, b->boy)) {
+				d->neden = "kesisme"; return -1;
+			}
+		}
+		d->a[d->n].bas = b->bas;
+		d->a[d->n].boy = b->yaz_boy ? b->yaz_boy : b->boy;
+		d->a[d->n].maske = b->maske;
+		d->n++;
+	}
+	d->durum = KK_KAPI_ACIK;
+	d->neden = NULL;
+	return 0;
+}
+
+/* [sektor, sektor+adet) izinli aralıklardan birinin içinde mi (profile göre). Taşma güvenli. */
+static inline int kk_kapi_yazma_izinli(const struct kk_kapi_durum *d, int profil,
+				       u64 sektor, u64 adet)
+{
+	int i;
+
+	if (d->durum != KK_KAPI_ACIK || profil < 1 || profil > 3 || adet == 0)
+		return 0;
+	for (i = 0; i < d->n; i++) {
+		const struct kk_kapi_aralik *a = &d->a[i];
+
+		if (!(a->maske & (1 << (profil - 1))))
+			continue;
+		if (adet > a->boy || sektor < a->bas)
+			continue;
+		if (sektor - a->bas > a->boy - adet)
+			continue;
+		return 1;
+	}
+	return 0;
+}
+
+/* EXT_CSD indeksleri (JEDEC) */
+#define KK_E_CMDQ_MODE		15
+#define KK_E_BARRIER_CTRL	31
+#define KK_E_FLUSH_CACHE	32
+#define KK_E_CACHE_CTRL		33
+#define KK_E_POWER_OFF_NOTIF	34
+#define KK_E_BKOPS_EN		163
+#define KK_E_BKOPS_START	164
+#define KK_E_HPI_MGMT		161
+#define KK_E_ERASE_GROUP_DEF	175
+#define KK_E_PART_CONFIG	179
+#define KK_E_BUS_WIDTH		183
+#define KK_E_HS_TIMING		185
+#define KK_E_POWER_CLASS	187
+
+/*
+ * CMD6 beyaz listesi (TASARIM §3; ana hat listesinin 4.9 başlatma yoluna genişletilmiş hâli).
+ * set: komut kümesi (yalnız 1 = normal); part_mevcut: kartın şu anki EXT_CSD[179] değeri.
+ * 1 = izinli.
+ */
+static inline int kk_kapi_cmd6_izinli(u32 set, u32 indeks, u32 deger, u32 part_mevcut)
+{
+	if (set != 1 || indeks > 255 || deger > 255)
+		return 0;
+	switch (indeks) {
+	case KK_E_HS_TIMING:		/* düşük nibble 0-3 (HS400=3), sürüş gücü nibble <= 4 */
+		return (deger & 0x0f) <= 3 && (deger >> 4) <= 4;
+	case KK_E_BUS_WIDTH:		/* 1/4/8 bit, DDR 4/8 bit, strobe'lu DDR8 (0x86) */
+		return deger == 0 || deger == 1 || deger == 2 || deger == 5 || deger == 6 || deger == 0x86;
+	case KK_E_PART_CONFIG:		/* üst bitler aynı; erişim 0 (kullanıcı), 1/2 (boot okuma); 3..7 ret */
+		return (deger & ~7u) == (part_mevcut & ~7u) && (deger & 7u) <= 2;
+	case KK_E_ERASE_GROUP_DEF:	return deger == 1;
+	case KK_E_POWER_CLASS:		return deger <= 0x1f;
+	case KK_E_POWER_OFF_NOTIF:	return deger <= 4;
+	case KK_E_CACHE_CTRL:		return deger <= 1;
+	case KK_E_FLUSH_CACHE:		return deger == 1;
+	case KK_E_HPI_MGMT:		return deger == 1;
+	case KK_E_BKOPS_EN:		return deger >= 1 && deger <= 3;	/* manuel|otomatik bitleri */
+	case KK_E_BKOPS_START:		return deger == 1;
+	case KK_E_BARRIER_CTRL:		return deger <= 1;
+	case KK_E_CMDQ_MODE:		return deger == 0;	/* yalnız kapatma */
+	default:			return 0;
+	}
+}
+
+/* mmc opkod sınıfı: 0 geçer, 1 yazma(24/25: aralık), 2 silme(38: aralık), 3 kapalı, 4 CMD6, 5 silme aralık kaydı(35/36) */
+enum { KK_OP_GEC = 0, KK_OP_YAZ = 1, KK_OP_SIL = 2, KK_OP_KAPALI = 3, KK_OP_SW = 4, KK_OP_SILARA = 5 };
+
+static inline int kk_kapi_opkod_sinif(u32 op)
+{
+	switch (op) {
+	case 24: case 25:		return KK_OP_YAZ;
+	case 35: case 36:		return KK_OP_SILARA;
+	case 38:			return KK_OP_SIL;
+	case 6:				return KK_OP_SW;
+	case 26: case 27: case 28: case 29:	/* CID/CSD yaz, yazma koruması set/clr */
+	case 42:			/* lock/unlock */
+	case 44: case 45: case 46: case 47: case 48:	/* komut kuyruğu */
+		return KK_OP_KAPALI;
+	default:			return KK_OP_GEC;
+	}
+}
+
+#endif /* KK_EMMC_KAPI_H */
