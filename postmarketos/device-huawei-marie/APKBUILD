# Reference: <https://postmarketos.org/devicepkg>
# Local recipe, not for the official pmaports tree.
pkgname=device-huawei-marie
pkgver=1
pkgrel=0
pkgdesc="Huawei P30 Lite (Kirin 710)"
url="https://github.com/if-kurt/linux-kirin710"
arch="aarch64"
license="MIT"
depends="
	linux-huawei-marie
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
"
options="!check !archcheck"

# No firmware subpackage on purpose: the Hi1102 Wi-Fi firmware is not
# redistributable. See ../README.md for where to take it from.

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

