#!/bin/bash
# Kara Kutu kk-bin ÖNERİSİ (G48, eMMC E4; ONAY BEKLİYOR, kk-bin'e KONMADI): ana hat Debian'ında (6.12 E2 imajı, SSH 2222)
# eMMC yazma penceresinin denetimi ve E4'ün TEK ham yazması.
#   kk-anahat-pencere denetle <cikti>  YALNIZ OKUMA: kk_yazma, DT (6 özellik), çekirdek GPT görünümü, kapasite, dmesg
#                                      sayaçları, kkdata (needs_recovery yok, /data ro), alan.img (immutable, 1 GiB, FIEMAP
#                                      ardışık = W_BAS), iç fs'te hedef bölgenin boş olduğu (debugfs -w YOK), 6 nokta, stat.
#   kk-anahat-pencere yaz <cikti>      denetle + E4: "ac" -> hedef bölgeye (pencere içi blok 261632..261887 = alan.img'de
#                                      1022 MiB'tan 1 MiB) belirlenimci 1 MiB desen, /dev/mmcblk0p68 üzerinden O_DIRECT
#                                      (CMD25'ler) -> HEMEN "kapat" -> geri okuma (p68, tüm disk, dosya) sha = desen;
#                                      6 nokta değişmedi; diskstats yazılan sektör farkı = 2048; dmesg ACIK 1 / KAPALI 1.
# loop/dm GEREKMEZ (E1/E2 çekirdeğinde CONFIG_BLK_DEV_LOOP ve DM yok). İç fs BAĞLANMAZ; hedef bölge iç fs'te boş bloklar
#   (4.9 "kk-49-alan oku" ve burada debugfs testb ile önce denetlenir) -> iç fs tutarlı kalır.
# Sabitler (W_BAS, 6 nokta sha'ları, desen sha'sı) betikte; değişirse betik sha'sı değişir -> yeniden onay (kural 12).
# Öz doğrulama: sha256 SHA256SUMS'taki satırla aynı değilse çalışmaz. Hedef uname ^6\.12\.[0-9]+-kk-g[0-9]+$ (kk-anahat-ssh).
# Cihaz betiği systemd-run birimi (SSH koparsa da sürer), RuntimeMaxSec=300; trap HER çıkışta "kapat" yazar ("yaz" modunda).
# Bekleme 65 x 5 sn (G50; kural 16). Çıkış: 0 tamam / 3 dur (ölçüt tutmadı; pencere kapatıldı) / 1 bağlantı / 64 girdi / 65 doğrulama.
# Log: /opt/kara-kutu/work/kk-bin-log/kk-bin.log.
# G50 (bakımcı onayı (i), G49 önerisi): ortak kk-bin kilidi (flock -n, work/kk-bin-log/kk-bin.kilit, fd 9); doluysa çıkış 77, hiçbir şey yapılmaz.
# G52 E6-0 ÖNERİSİ (ONAY BEKLİYOR, kk-bin'e KONMADI): alan.img iç fs'inin açılışta bağlandığı E6 imajı için iki yeni mod:
#   kk-anahat-pencere e6 <cikti>          YALNIZ OKUMA: kk-alan durumu (/run/kk-alan), pencere, loop sysfs (ro/dio/ofset/boy),
#                                         bağlama seçenekleri, /var/log/journal bind'i, journald'ın alana yazdığı, sayaç,
#                                         kapsam (eMMC yazma sektörü = loop yazma sektörü), discard 0, sınır bekçileri, dmesg.
#                                         kip rw / ro / kapali için ayrı ölçüt; kip yok/dur/bozuk -> DUR. Hiçbir şey yazmaz.
#   kk-anahat-pencere e6-sifirla <cikti>  YALNIZ kk-alan kip=ro (SAYAC-DUR ya da sayac-okunamadi) iken ve pencere "hazir"ken:
#                                         ro bağlamayı ve ro loop'u bırakır -> "ac" -> rw loop (O_DIRECT) -> e2fsck -f -p (rc 0/1;
#                                         başka -> DUR, -y YOK) -> rw bağla -> sayaç kirli=0 duz=0 durum=KAPALI (yerinde O_DIRECT,
#                                         4 KiB) -> umount -> losetup -d -> "kapat" -> ro loop'tan e2fsck -fn rc 0 + sayaç geri okuma.
#                                         Pencere o açılışta kilitli kalır; alan sonraki açılışta rw kipe döner.
# G50 E5 (bakımcı onayı: U1 + E5 sınamaları geçerse; tek sefer):
#   kk-anahat-pencere e5 <cikti>       denetle (E4 izi = desen beklenir; iç fs SALT OKUNUR loop'tan: temiz, hiç bağlanmamış, /kk-e5
#                                      yok) + E5: "ac" -> loop (p68, ofset 557056 x 4096, 1 GiB, --direct-io=on) -> mount -w (rw,noatime,
#                                      nodiscard,noinit_itable,data=ordered,errors=remount-ro) -> TEK test dosyası /kk-e5/e5-test.bin
#                                      (4 MiB belirlenimci desen, son satırı işaret satırı, sha sabit) + fsync -> umount -> losetup -d ->
#                                      "kapat" -> (pencere KAPALI) yeni salt okunur loop: e2fsck -fn, dumpe2fs, debugfs cat sha, bloklar,
#                                      E4 dilimi, 4 yedek süper blok, diskstats (yazma <= 64 MiB, discard 0), dmesg, pencere açık süresi.
#   Trap (her çıkış): umount -> bizim loop'larımızı sil -> "kapat" (sıra önemli). alan.img /data üzerinden okunmaz (önbellek).
#   denetle G50'de E4 izini (hedef = desen) bekler; yaz (E4) hedef desense DUR (ikinci E4 yok; değişmedi).
set -u
KB=/opt/kara-kutu/tools/kk-bin; ME=$(realpath -- "$0")
LOG=/opt/kara-kutu/work/kk-bin-log/kk-bin.log; mkdir -p "${LOG%/*}"
log() { echo "$(date -u '+%F %T.%3N') UTC [kk-anahat-pencere] $*" | tee -a "$LOG" >&2; }
[ $# -eq 2 ] || { echo "kullanim: kk-anahat-pencere denetle|yaz|e5|e6|e6-sifirla <cikti-dosyasi>" >&2; exit 64; }
MOD=$1; case $MOD in denetle|yaz|e5|e6|e6-sifirla) ;; *) echo "kullanim: kk-anahat-pencere denetle|yaz|e5|e6|e6-sifirla <cikti-dosyasi>" >&2; exit 64;; esac
OUT=$(realpath -m -- "$2")
case $OUT in /opt/kara-kutu/work/*) ;; *) log "DUR: cikti work/ disinda: $OUT"; exit 64;; esac
[ -e "$OUT" ] && { log "DUR: cikti zaten var: $OUT"; exit 64; }
[ -d "${OUT%/*}" ] || { log "DUR: dizin yok: ${OUT%/*}"; exit 64; }
want=$(awk '$2=="kk-anahat-pencere"{print $1}' "$KB/SHA256SUMS"); have=$(sha256sum "$ME" | cut -c1-64)
[ -n "$want" ] && [ "$want" = "$have" ] || { log "DUR: betik sha256 SHA256SUMS ile tutmadi ($have)"; exit 65; }
CIHAZ=$(sed -n '/^#--- CIHAZ BASI ---$/,/^#--- CIHAZ SONU ---$/p' "$ME")
CSHA=$(printf '%s\n' "$CIHAZ" | sha256sum | cut -c1-64)
# --- G49 ortak kilit (kural 17'nin mekanik karşılığı): cihaza dokunan kk-bin çağrıları tek tek. ---
# flock, work/kk-bin-log/kk-bin.kilit üzerinde, fd 9. Bekleme YOK (-n): kilit doluysa hemen 77, cihaz işlemi yapılmaz.
# Miras: iç içe kk-bin çağrısı üstünün fd 9'unu (aynı açık dosya tanımı) devralır; flock aynı tanımda yeniden başarılı.
# Ortam değişkeni (KK_KILIT_SAHIBI) yalnız log içindir; mirası açmaz. Kilidi tutan süreç ve fd 9'u devralan çocukları
# bitince (SIGKILL dahil) çekirdek kilidi bırakır: bayat kilit olmaz (dosya kalır, içeriği yalnız "son sahip" bilgisi).
KK_KILIT=/opt/kara-kutu/work/kk-bin-log/kk-bin.kilit
kk_kilit() {
	local kl=${KK_KILIT%/*}/kk-bin.log ad=${0##*/} t
	t=$(date -u '+%F %T.%3N')
	mkdir -p "${KK_KILIT%/*}" || exit 77
	if [ /proc/$$/fd/9 -ef "$KK_KILIT" ] && flock -n 9; then
		echo "$t UTC [$ad] kilit: miras (sahip ${KK_KILIT_SAHIBI:-?}; pid $$)" >> "$kl"; return 0
	fi
	if exec 9>>"$KK_KILIT" && flock -n 9; then
		export KK_KILIT_SAHIBI="pid=$$ $ad"
		printf 'pid=%s betik=%s arg=%.80s bas=%s UTC\n' $$ "$ad" "$*" "$t" > "$KK_KILIT"
		echo "$t UTC [$ad] kilit: alindi (pid $$)" >> "$kl"; return 0
	fi
	echo "$t UTC [$ad] RED: kk-bin kilidi mesgul (son sahip: $(head -c 200 "$KK_KILIT" 2>/dev/null | tr -d '\n')); cihaz islemi YAPILMADI; cikis 77" | tee -a "$kl" >&2
	exit 77
}
kk_kilit "$@"
# --- G49 ortak kilit sonu ---
T=$(mktemp -d) || exit 70
SSH=(ssh -p 2222 -o UserKnownHostsFile=$KB/known_hosts_anahat -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10
     -o ServerAliveInterval=5 -o ServerAliveCountMax=3 -S "$T/s" ${KK_KULLANICI:-kk}@172.16.42.1)
bitir() { "${SSH[@]}" -O exit >/dev/null 2>&1; rm -f -- "$T/s"; rmdir -- "$T" 2>/dev/null; }
trap bitir EXIT
r() { timeout 60 "${SSH[@]}" "$1"; }
timeout 20 "${SSH[@]}" -M -fN 9>&- 2>/dev/null || { log "DUR: 172.16.42.1:2222 baglanti yok"; exit 1; }
un=$(r 'uname -r' 2>/dev/null | tr -d '\r')
[[ $un =~ ^6\.12\.[0-9]+-kk-g[0-9]+$ ]] || { log "DUR: uname tutmadi ('${un:0:60}'); hicbir sey yapilmadi"; exit 65; }
onceki=$(r 'systemctl is-active kk-anahat-pencere.service' 2>/dev/null | tr -d '\r\n')
[ "$onceki" = inactive ] || { log "DUR: onceki birim durumu: '$onceki'"; exit 65; }
uz=$(printf '%s\n' "$CIHAZ" | timeout 30 "${SSH[@]}" 'sudo -n tee /run/kk-anahat-pencere.sh >/dev/null && sudo -n sh -n /run/kk-anahat-pencere.sh && sha256sum /run/kk-anahat-pencere.sh' 2>&1 | cut -c1-64)
[ "$uz" = "$CSHA" ] || { log "DUR: cihaz betigi sha tutmadi (yerel $CSHA, uzak '${uz:0:64}')"; exit 65; }
log "uname OK $un; cihaz betigi /run/kk-anahat-pencere.sh sha $CSHA; mod=$MOD -> $OUT"
r "sudo -n systemd-run --unit=kk-anahat-pencere --collect -p RuntimeMaxSec=300 /bin/sh /run/kk-anahat-pencere.sh $MOD" >/dev/null 2>&1 \
	|| { log "DUR: systemd-run basarisiz"; exit 3; }
# Bekleme: sleep + kesin üst süre (G50: 65 x 5 sn = 325 sn > birimin 300 sn'si -> birim bitmeden çıktı alınmaz); durum birim adıyla (kural 16).
st=active; i=0
while [ $i -lt 65 ]; do
	sleep 5; i=$((i+1))
	st=$(r 'systemctl is-active kk-anahat-pencere.service' 2>/dev/null | tr -d '\r'); st=${st:-baglanti-yok}
	case $st in active|activating|baglanti-yok) ;; *) break;; esac
done
log "birim: $st ($((i * 5)) sn)"
{ r 'cat /run/kk-anahat-pencere.log'; echo "=== fiemap"; r 'cat /run/kk-anahat-pencere-fiemap.txt 2>/dev/null'; echo "=== e5"; r 'cat /run/kk-anahat-pencere-e5.txt 2>/dev/null'; echo "=== e6"; r 'cat /run/kk-anahat-pencere-e6.txt 2>/dev/null'; } > "$OUT" 2>&1
grep -E 'DUR|SONUC|ACIK|KAPALI|DESEN|YAZMA|E5|E6|PENCERE|ICFS' "$OUT" | cut -c1-240 >&2
if grep -q ' SONUC tamam' "$OUT"; then log "TAMAM: mod=$MOD; $(grep -m1 ' SONUC tamam' "$OUT" | cut -c1-200)"; exit 0; fi
log "UYARI: mod=$MOD tamamlanmadi (birim $st); cikti $OUT"; exit 3

#--- CIHAZ BASI ---
# /run/kk-anahat-pencere.sh <denetle|yaz|e5>  (root, systemd-run birimi; ana hat Debian). KK_* YALNIZ yerel/QEMU sınaması içindir.
set -u
MOD=${1:-denetle}
case $MOD in denetle|yaz|e5|e6|e6-sifirla) ;; *) echo "mod gecersiz" >&2; exit 64;; esac
L=${KK_LOG:-/run/kk-anahat-pencere.log}; FM=${KK_FM:-/run/kk-anahat-pencere-fiemap.txt}; DS=${KK_DESEN:-/run/kk-anahat-pencere-desen.bin}
EK=${KK_EK:-/run/kk-anahat-pencere-e5.txt}; TD=${KK_TD:-/run/kk-anahat-pencere-e5.bin}; MNT=${KK_MNT:-/run/kk-anahat-pencere-e5-mnt}
W_BAS=${KK_W_BAS:-21282816}; W_SAY=2097152; W_SON=$((W_BAS + W_SAY))
UD_BAS=${KK_UD_BAS:-16826368}; UD_BOY=${KK_UD_BOY:-227450880}; KART=${KK_KART:-244277248}; NO=${KK_NO:-68}
PUUID=${KK_PUUID:-@@GUID@@}
DT=${KK_DT:-/proc/device-tree/soc/mmc@ff3e6000}; DSK=${KK_DSK:-mmcblk0}; PRT=${KK_PRT:-mmcblk0p68}; SYS=${KK_SYS:-/sys}; DEV=${KK_DEV:-/dev}
ALAN=${KK_ALAN:-/data/kk/anahat/alan.img}; KKD=${KK_KKD:-/data}; WBK=${KK_WBK:-5}; KATI=${KK_KATI:-1}
DOSYA=${KK_DOSYA:-1}	# 0 yalnız QEMU: kkdata'da pencereye eşlenen dosya yok -> dosya görünümü denetimleri atlanır
H="${KK_NOKTA:-76fdd555f1c00fb113948e2a3261ddadbec12e47f7af5dc447eedc23cf112c15 e87a53a5542c685e13b8675eee66219e86e37835fcdb9a743c049ed6e1c99d7d c5f198338eab40bb3a4b6a3156e491e09ed24f40c8a38b2db79b1950e5a4c399 e115f472556e1079f818240c89478785241bbe3fd26f78563783631b2a606812 3a72239a04d00253b0d2786abfe18c1110e2391ed6b9d0758c0eb07125c715c4 ad7facb2586fc6e966c004d7d1d16b024f5805ff7cb47c7a85dabd8b48892ca7}"
DESEN_SHA=${KK_DESEN_SHA:-a11533fecd41fc0ff15febc24478e179af6475b21e20f002edee75c21981dea5}
HB=261632; HN=256	# hedef: pencere/dosya içi blok 261632..261887 (1022 MiB + 1 MiB); 6 noktayla kesişmez
# G50 E5: iç fs'e TEK test dosyası (4 MiB belirlenimci desen; son satırı işaret satırı; sha sabit, QEMU ve cihazda aynı)
E5_SHA=${KK_E5_SHA:-cabb2162356224aa593571b51949c84e52445be3a70341859e578d00ce14859c}; E5_BOY=4194304; E5_YOL=/kk-e5/e5-test.bin
YAZ_AZAMI=131072	# E5 toplam yazma üst sınırı (diskstats yazma sektörü farkı): 64 MiB
IBOY=1073741824	# iç fs (alan.img) = pencere boyu
PB=$(( (W_BAS - UD_BAS) / 8 )); DB=$((W_BAS / 8)); KY=$SYS/block/$DSK/kk_yazma; OFS=$((PB * 4096)); P=$SYS/class/block/$PRT
: > "$L"; rm -f "$FM" "$DS" "$EK" "$TD"
log() { echo "$(date -u '+%T') $*" >> "$L"; }
ACILDI=0; BITTI=0; MNTD=0; MKD=0; LR=; LW=
dur() { log "DUR: $*"; exit 3; }
lp() {	# p68'e bağlı loop aygıtları (sysfs backing_file; util-linux çıktısına bağlı değil)
	for b in $SYS/block/loop*/loop/backing_file; do
		[ -f "$b" ] && [ "$(cat "$b")" = "$DEV/$PRT" ] && { b=${b%/loop/backing_file}; echo "$DEV/${b##*/}"; }
	done
}
son() {
	rc=$?
	# G50 E5: sıra önemli: önce umount (iç fs tutarlı kapanır), sonra BİZİM loop'larımız, en son pencere "kapat"
	if [ $MNTD = 1 ]; then umount "$MNT" 2>> "$L"; log "trap: umount rc=$?"; fi
	for x in $LW $LR; do losetup -d "$x" 2>> "$L"; log "trap: losetup -d $x rc=$?"; done
	if [ $ACILDI = 1 ]; then echo kapat > "$KY" 2>/dev/null; log "trap: kapat yazildi; kk_yazma: $(cat "$KY" 2>&1)"; fi
	[ $MKD = 1 ] && rmdir "$MNT" 2>/dev/null	# yalnız bizim açtığımız bağlama noktası
	rm -f "$DS" "$TD"
	[ $BITTI = 1 ] || log "SONUC dur rc=$rc"
}
trap son EXIT; trap 'exit 4' INT TERM HUP
q() { od -An -v -tu1 "$DT/karakutu,$1" | awk '{for(i=1;i<=NF;i++){v=v*256+$i;if(++n%4==0){printf "%s%.0f",s,v;s=" ";v=0}}}END{print ""}'; }
r() { tr -d '\000' < "$DT/karakutu,$1"; }
dm() { dmesg | grep -v 'kk: dmesg:' | grep -cF -- "$1"; }
st() { set -- $(cat $SYS/block/$DSK/stat); echo "$5 $7 ${12} ${16}"; }	# yazma_io yazma_sektor discard_io flush_io
oku4k() { dd if="$1" bs=4096 skip=$2 count=${3:-1} iflag=direct 2>/dev/null | sha256sum | cut -c1-64; }
esit() { [ "$2" = "$3" ] || dur "$1: '$2' (beklenen '$3')"; log "ok $1 = $2"; }
# G50: loop sysfs (ro, ofset, boy, direct-io, arka aygıt) ve iç fs üst bilgisi (tek satır)
lo_bak() { y=$SYS/block/${2##*/}; esit "$1" "$(cat $y/ro) $(cat $y/loop/offset) $(cat $y/loop/sizelimit) $(cat $y/loop/dio) $(cat $y/loop/backing_file)" "$3 $OFS $IBOY 1 $DEV/$PRT"; }
dh() { dumpe2fs -h "$1" 2>/dev/null | awk -F': *' '/^Filesystem volume name:/{a=$2} /^Filesystem state:/{d=$2} /^Filesystem features:/{k=($2 ~ /needs_recovery/)} /^Mount count:/{m=$2} END{printf "ad=%s durum=%s kurtarma=%d baglama=%s\n", a, d, k, m}'; }
ek() { echo "=== $1" >> "$EK"; shift; "$@" >> "$EK" 2>&1; }
kes() { case "${KK_E5_KES:-}" in "$1") dur "sinama kesmesi: $1";; "term-$1") log "sinama: TERM ($1)"; kill -TERM $$; sleep 2;; esac; }	# YALNIZ QEMU

# --- e6 / e6-sifirla (G52 E6-0): kk-alan oturumu denetimi (YALNIZ OKUMA) / RO kipinden çıkış (tek onaylı yazma) ---
if [ $MOD = e6 ] || [ $MOD = e6-sifirla ]; then
	KR=${KK_ALAN_RUN:-/run/kk-alan}; AM=${KK_ALAN_MNT:-/alan}; JD=${KK_JD:-/var/log/journal}; SAYAC=/kk/durum/sayac
	IUUID=${KK_IUUID:-@@GUID@@}; E6K=${KK_E6K:-/run/kk-anahat-pencere-e6.txt}; rm -f "$E6K"
	al() { echo " $1 " | tr ' ' '\n' | sed -n "s/^$2=//p" | head -n 1; }
	e6k() { echo "=== $1" >> "$E6K"; shift; "$@" >> "$E6K" 2>&1; }
	lws() { set -- $(cat "$SYS/block/${1##*/}/stat"); echo "$7"; }
	sin() { echo "$(oku4k $DEV/$PRT $((PB - 256)) 256) $(oku4k $DEV/$PRT $((PB + 262144)) 256)"; }
	# G53 A12-1: E6 loop'ları TÜM DİSK üzerinde mutlak ofsetle (kk-alan ile aynı); E4/E5'in lp/lo_bak'ı DEĞİŞMEDİ
	DOFS=$((W_BAS * 512)); KA=$SYS/block/$DSK/kk_a12
	lp6() { for b in $SYS/block/loop*/loop/backing_file; do [ -f "$b" ] && case "$(cat "$b")" in "$DEV/$PRT"|"$DEV/$DSK") b=${b%/loop/backing_file}; echo "$DEV/${b##*/}";; esac; done; }
	lo6() { y=$SYS/block/${2##*/}; esit "$1" "$(cat $y/ro) $(cat $y/loop/offset) $(cat $y/loop/sizelimit) $(cat $y/loop/dio) $(cat $y/loop/backing_file)" "$3 $DOFS $IBOY 1 $DEV/$DSK"; }
	a12r() { echo " $(cat "$KA" 2>/dev/null) " | tr ' ' '\n' | sed -n 's/^red=//p' | head -n 1; }
	hat() { dmesg | grep -v 'kk: dmesg:' | grep -ciE 'I/O error|EXT4-fs (error|warning)|Buffer I/O|recovery failed|HW reset card|mmc[0-9]+: .*timeout|remounting filesystem read-only|JBD2: .*(error|abort)'; }
	log "basladi mod=$MOD uname=$(uname -r) up=$(cut -d' ' -f1 /proc/uptime) W=[$W_BAS, $W_SON)"
	case "$(uname -r)" in 6.12.*-kk-g*) ;; *) [ -n "${KK_LOG:-}" ] || dur "uname ana hat degil";; esac
	for t in losetup e2fsck dumpe2fs debugfs mount umount findmnt dd sha256sum awk journalctl systemctl blockdev; do command -v $t > /dev/null || dur "arac yok: $t"; done
	esit dt-aralik "$(q yazma-araligi)" "$W_BAS $W_SAY"
	esit dt-bolum "$(r yazma-bolum) $(q yazma-bolum-no) $(q yazma-bolum-araligi)" "userdata $NO $UD_BAS $UD_BOY"
	esit dt-uuid-kart "$(r yazma-partuuid) $(q kart-sektor)" "$PUUID $KART"
	esit gpt "$(cat $P/start) $(cat $P/size) $(cat $P/partition) $(sed -n 's/^PARTNAME=//p' $P/uevent)" "$UD_BAS $UD_BOY $NO userdata"
	if [ "$DOSYA" = 1 ]; then
		esit kkdata "$(findmnt -rn -o SOURCE,FSTYPE "$KKD")" "/dev/$PRT ext4"
		case ",$(findmnt -rn -o OPTIONS "$KKD")," in *,ro,*) log "ok kkdata ro";; *) dur "kkdata ro bagli degil";; esac
		[ -e "$KKD/kk/state/anahat-alan-bozuk" ] && dur "anahat-alan-bozuk isareti var"
		esit alan-boy "$(stat -c %s "$ALAN")" 1073741824
		case "$(lsattr -d "$ALAN" | cut -d' ' -f1)" in *i*) log "ok alan immutable";; *) dur "alan.img immutable degil";; esac
		filefrag -v -e "$ALAN" > "$FM" 2>&1
		esit fiemap "$(awk '/^ *[0-9]+:/{s=$0;gsub(/\.\./," ",s);gsub(/:/," ",s);split(s,x," ");if(!e){i=x[4];if(x[2]!=0)b=1}else if(x[2]!=l+1||x[4]!=p+1)b=1;if(s~/unwritten/)u++;l=x[3];p=x[5];T+=x[6];e++}END{printf "ilk=%s top=%d uw=%d kes=%d\n",i,T,u,b}' "$FM")" "ilk=$PB top=262144 uw=0 kes=0"
	fi
	KD=$(cat "$KR/durum" 2>/dev/null); KIP=$(al "$KD" kip); log "E6 kk-alan durum: ${KD:-YOK}"
	e6k "kk-alan birimleri" sh -c "systemctl is-active kk-alan.service kk-alan-izle.timer systemd-journal-flush.service 2>&1 | tr '\n' ' '; echo; journalctl -b -u kk-alan.service -u kk-alan-izle.service --no-pager -o cat 2>&1 | tail -n 60"
	e6k "kk-alan durum" /usr/local/sbin/kk-alan durum
