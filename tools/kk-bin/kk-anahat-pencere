	esit dmesg-sonra "acik=$(dm "kk: yazma penceresi ACIK [$W_BAS, $W_SON)") kapali=$(dm 'kk: yazma penceresi KAPALI, kilitli (sysfs)') blokred=$(dm 'kk: blok yazma reddedildi') wb=$(dm 'kk: mmc write blocked: ') wb2425=$(dmesg | grep -v 'kk: dmesg:' | grep -c 'mmc write blocked: CMD2[45] ') hata=$(dmesg | grep -v 'kk: dmesg:' | grep -ciE 'I/O error|EXT4-fs (error|warning)|Buffer I/O|recovery failed|HW reset card|mmc[0-9]+: .*timeout|remounting filesystem read-only|JBD2: .*(error|abort)')" \
		"acik=1 kapali=1 blokred=0 wb=$WBK wb2425=0 hata=0"
	ek "dmesg ext4/loop/kk satirlari" sh -c "dmesg | grep -v 'kk: dmesg:' | grep -E 'EXT4-fs \(loop|loop[0-9]+:|yazma penceresi|kk-anahat-pencere' | tail -n 20"
	LR=$(losetup -r --direct-io=on -o $OFS --sizelimit $IBOY -f --show "$DEV/$PRT" 2>> "$L"); log "ICFS ro loop (sonra): '$LR'"
	case $LR in "$DEV"/loop[0-9]*) ;; *) dur "ro loop (sonra) kurulamadi";; esac
	lo_bak ro-loop-sonra "$LR" 1
	e2fsck -fn "$LR" > "$EK.e2" 2>&1; er=$?; ek "e2fsck -fn (sonra) rc=$er" cat "$EK.e2"; rm -f "$EK.e2"
	esit icfs-e2fsck-sonra "rc=$er" rc=0
	esit icfs-sonra "$(dh "$LR")" "ad=kk-anahat durum=clean kurtarma=0 baglama=1"
	ek "ic fs kok (sonra)" debugfs -R "ls -l /" "$LR"
	ek "ic fs /kk-e5 (sonra)" debugfs -R "ls -l ${E5_YOL%/*}" "$LR"
	ek "dumpe2fs -h (sonra)" dumpe2fs -h "$LR"
	esit e5-dosya "$(debugfs -R "stat $E5_YOL" "$LR" 2>/dev/null | sed -n 's/.*Size: \([0-9]*\).*/\1/p' | head -n 1) $(debugfs -R "cat $E5_YOL" "$LR" 2>/dev/null | sha256sum | cut -c1-64)" "$E5_BOY $E5_SHA"
	BL=$(debugfs -R "blocks $E5_YOL" "$LR" 2>/dev/null); ek "e5 dosya bloklari" echo "$BL"
	esit e5-bloklar "$(echo $BL | awk -v h=$HB -v n=$HN '{for(i=1;i<=NF;i++){b=$i;c++;if(b>=h&&b<h+n)e++;if(b==0||b==32768||b==98304||b==163840||b==229376||b==262143)k++;if(c==1||b<a)a=b;if(b>z)z=b}}END{printf "say=%d e4=%d nokta=%d\n",c,e,k}')" "say=$((E5_BOY / 4096)) e4=0 nokta=0"
	log "E5 dosya bloklari: $(echo $BL | awk '{a=$1;z=$1;for(i=2;i<=NF;i++){if($i<a)a=$i;if($i>z)z=$i}printf "en_kucuk=%s en_buyuk=%s say=%d", a, z, NF}')"
	esit e4-dilim-sonra "$(oku4k $DEV/$PRT $((PB + HB)) $HN) $(oku4k "$LR" $HB $HN)" "$DESEN_SHA $DESEN_SHA"
	esit icfs-hedef-bos-sonra "$(debugfs -R "testb $HB $HN" "$LR" 2>/dev/null | grep -c 'not in use')" $HN
	set -- $H; NS=
	for o in 0 32768 98304 163840 229376 262143; do
		a=$(oku4k $DEV/$PRT $((PB + o))); m=$(oku4k $DEV/$DSK $((DB + o))); c=$(oku4k "$LR" $o)
		[ "$a" = "$m" ] && [ "$a" = "$c" ] || dur "nokta-sonra+$o: p68/disk/loop farkli ($a $m $c)"
		case $o in 0|262143) log "bilgi nokta-sonra+$o = $a ($([ "$a" = "$1" ] && echo ayni || echo degisti))"; NS="$NS $o:$([ "$a" = "$1" ] && echo ayni || echo degisti)";;
		*) esit "yedek-superblok+$o" "$a" "$1";; esac
		shift
	done
	losetup -d "$LR" 2>> "$L" || dur "ro loop (sonra) silinemedi"; LR=
	[ -z "$(lp)" ] || dur "dogrulamadan sonra p68'de loop var"
	esit ac-tekrar "$(echo ac > "$KY" 2>/dev/null && echo acildi || echo red) $(cat "$KY" | cut -d' ' -f1)" "red durum=kilitli"
	esit stat-dogrulama-yazmadi "$(st)" "$S1"
	BITTI=1
	log "E5 SONUC dosya=$E5_YOL sha256=$E5_SHA yazma_sektor=$YSEK yazma_io=$YIO discard=$DIO flush=$FIO acik_sure=${AS}sn noktalar:$NS"
	log "SONUC tamam mod=e5 W_BAS=$W_BAS e5_sha=$E5_SHA yazma_sektor=$YSEK acik_sure=${AS}sn"
	exit 0
fi

# --- yaz (E4): desen -> ac -> tek O_DIRECT yazma -> kapat -> doğrula ---
HS=$((W_BAS + HB * 8))
awk -v b=$HS 'BEGIN{for(i=0;i<2048;i++){s=sprintf("KK-G48-E4 sektor=%010d ",b+i);while(length(s)<511)s=s ".";print s}}' > "$DS"
esit desen "$(stat -c %s "$DS") $(sha256sum < "$DS" | cut -c1-64)" "1048576 $DESEN_SHA"
ACILDI=1
echo ac > "$KY" || dur "ac yazilamadi (rc $?)"
esit durum-acik "$(cat "$KY")" "durum=acik bas=$W_BAS son=$W_SON neden=-"
log "YAZMA basliyor: $DEV/$PRT blok $((PB + HB))+$HN (mutlak sektor $HS..$((HS + 2047)))"
dd if="$DS" of=$DEV/$PRT bs=4096 seek=$((PB + HB)) count=$HN oflag=direct conv=notrunc,fsync 2>> "$L"; yr=$?
echo kapat > "$KY"; kr=$?
log "YAZMA dd rc=$yr; kapat rc=$kr; kk_yazma: $(cat "$KY")"
case "$(cat "$KY")" in durum=kilitli*) ACILDI=0;; *) dur "kapat sonrasi kilitli degil";; esac
[ $yr = 0 ] || dur "yazma basarisiz (dd rc $yr)"
S1=$(st); set -- $S1
esit stat-fark "$1 $2 $3 $4" "$1 2048 0 0"
[ "$1" -ge 1 ] || dur "yazma_io 0"
sync; echo 3 > /proc/sys/vm/drop_caches
esit geri-p68 "$(oku4k $DEV/$PRT $((PB + HB)) $HN)" $DESEN_SHA
esit geri-disk "$(oku4k $DEV/$DSK $((DB + HB)) $HN)" $DESEN_SHA
[ "$DOSYA" = 1 ] && esit geri-dosya "$(oku4k "$ALAN" $HB $HN)" $DESEN_SHA
set -- $H
for o in 0 32768 98304 163840 229376 262143; do esit "nokta-sonra+$o" "$(oku4k $DEV/$PRT $((PB + o))) $(oku4k $DEV/$DSK $((DB + o)))" "$1 $1"; shift; done
esit dmesg-sonra "acik=$(dm "kk: yazma penceresi ACIK [$W_BAS, $W_SON)") kapali=$(dm 'kk: yazma penceresi KAPALI, kilitli (sysfs)') blokred=$(dm 'kk: blok yazma reddedildi') wb=$(dm 'kk: mmc write blocked: ') wb2425=$(dmesg | grep -v 'kk: dmesg:' | grep -c 'mmc write blocked: CMD2[45] ') hata=$(dmesg | grep -v 'kk: dmesg:' | grep -ciE 'I/O error|EXT4-fs error|Buffer I/O|recovery failed|HW reset card|mmc[0-9]+: .*timeout')" \
	"acik=1 kapali=1 blokred=0 wb=$WBK wb2425=0 hata=0"
esit ac-tekrar "$(echo ac > "$KY" 2>/dev/null && echo acildi || echo red) $(cat "$KY" | cut -d' ' -f1)" "red durum=kilitli"
BITTI=1
log "DESEN sha256=$DESEN_SHA sektor=$HS+2048 stat=$S1"
log "SONUC tamam mod=yaz W_BAS=$W_BAS hedef_once=$HO hedef_sonra=$DESEN_SHA"
exit 0
