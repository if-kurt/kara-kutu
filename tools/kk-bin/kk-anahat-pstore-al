#!/bin/bash
# Kara Kutu kk-bin (G57 G-8 önerisi): ana hat Debian'ında (SSH 2222) /sys/fs/pstore kayıtlarını ana makineye al. SİLMEZ.
#   kk-anahat-pstore-al <hedef-dizin>
# kk-pstore-al'ın ana hat karşılığı. Yol farkı: ana hatta systemd-pstore MASKELİ (init üst katmanı) -> kayıtlar
#   /var/lib/systemd/pstore'a taşınmaz, /sys/fs/pstore'da (önceki açılışın console/pmsg/dmesg-ramoops) kalır.
#   Cihazda yalnız `ls` ve `tar -c` (okuma); unlink yok. Uzak komutlar sabit metin (<= 1000 karakter).
# Hedef SABİT: ${KK_KULLANICI:-kk}@172.16.42.1 port 2222, known_hosts_anahat; uname ^6\.12\.[0-9]+-kk-g[0-9]+$ aynı ana bağlantıda.
# Hedef dizin /opt/kara-kutu/work/ altında, yok ya da boş. Sonuç: kaynak.txt (uname, boot_id), ls.txt, pstore.tar,
#   açılmış dosyalar, SHA256SUMS (kk-pstore-al ile aynı düzen).
# Çıkış: 0 tamam / 1 bağlantı yok ya da tar alınamadı / 64 girdi / 65 uname tutmadı / 77 kilit dolu.
# Log: /opt/kara-kutu/work/kk-bin-log/kk-bin.log. Kurmak/değiştirmek bakımcı onayı.
# Ortak kk-bin kilidi (flock -n, work/kk-bin-log/kk-bin.kilit, fd 9); doluysa çıkış 77, hiçbir şey yapılmaz.
# Ölü adam (G58): bu araç kk-fb-oluadam'ın IZLEME listesinde; satırları ([kk-anahat-pstore-al]) "kk-bin sessizliği"ni bozmaz.
set -u
KB=/opt/kara-kutu/tools/kk-bin
H=172.16.42.1; P=2222; U=${KK_KULLANICI:-kk}
UNAME_RE='^6\.12\.[0-9]+-kk-g[0-9]+$'
LOG=/opt/kara-kutu/work/kk-bin-log/kk-bin.log; mkdir -p "${LOG%/*}"
log() { echo "$(date -u '+%F %T.%3N') UTC [kk-anahat-pstore-al] $*" | tee -a "$LOG"; }
[ "$P" = 2222 ] || exit 70
[ $# -eq 1 ] || { echo "kullanim: kk-anahat-pstore-al <hedef-dizin>" >&2; exit 64; }
D=$(realpath -m -- "$1")
case $D in /opt/kara-kutu/work/?*) ;; *) log "DUR: hedef work/ disinda: $D"; exit 64;; esac
# --- G49 ortak kilit (kural 17'nin mekanik karşılığı): cihaza dokunan kk-bin çağrıları tek tek. ---
# flock, work/kk-bin-log/kk-bin.kilit üzerinde, fd 9. Bekleme YOK (-n): kilit doluysa hemen 77, cihaz işlemi yapılmaz.
# Miras: iç içe kk-bin çağrısı üstünün fd 9'unu (aynı açık dosya tanımı) devralır; flock aynı tanımda yeniden başarılı.
# Ortam değişkeni (KK_KILIT_SAHIBI) yalnız log içindir; mirası açmaz. Kilidi tutan süreç ve fd 9'u devralan çocukları
# bitince (SIGKILL dahil) çekirdek kilidi bırakır: bayat kilit olmaz (dosya kalır, içeriği yalnız "son sahip" bilgisi).
KK_KILIT=/opt/kara-kutu/work/kk-bin-log/kk-bin.kilit
kk_kilit() {
	local kl=${KK_KILIT%/*}/kk-bin.log ad=${0##*/} t
	t=$(date -u '+%F %T.%3N')
	mkdir -p "${KK_KILIT%/*}" || exit 77
	if [ /proc/$$/fd/9 -ef "$KK_KILIT" ] && flock -n 9; then
		echo "$t UTC [$ad] kilit: miras (sahip ${KK_KILIT_SAHIBI:-?}; pid $$)" >> "$kl"; return 0
	fi
	if exec 9>>"$KK_KILIT" && flock -n 9; then
		export KK_KILIT_SAHIBI="pid=$$ $ad"
		printf 'pid=%s betik=%s arg=%.80s bas=%s UTC\n' $$ "$ad" "$*" "$t" > "$KK_KILIT"
		echo "$t UTC [$ad] kilit: alindi (pid $$)" >> "$kl"; return 0
	fi
	echo "$t UTC [$ad] RED: kk-bin kilidi mesgul (son sahip: $(head -c 200 "$KK_KILIT" 2>/dev/null | tr -d '\n')); cihaz islemi YAPILMADI; cikis 77" | tee -a "$kl" >&2
	exit 77
}
kk_kilit "$@"
# --- G49 ortak kilit sonu ---
if [ -e "$D" ]; then [ -d "$D" ] && [ -z "$(ls -A "$D")" ] || { log "DUR: hedef bos bir dizin degil: $D"; exit 64; }
else mkdir -p "$D" || exit 70; fi

# --- G57 G-8 ana hat SSH (kk-anahat-ssh ile aynı seçenekler; tek ana bağlantı, uname aynı bağlantıda) ---
T=$(mktemp -d) || exit 70
O=(-p "$P" -o UserKnownHostsFile="$KB/known_hosts_anahat" -o StrictHostKeyChecking=yes -o BatchMode=yes
   -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 -S "$T/s")
bitir() { [ -S "$T/s" ] && ssh "${O[@]}" -O exit "$U@$H" >/dev/null 2>&1 </dev/null; rm -f -- "$T/s"; rmdir -- "$T" 2>/dev/null; }
trap bitir EXIT
timeout 20 ssh "${O[@]}" -M -fN "$U@$H" 9>&- 2>/dev/null </dev/null || { log "DUR: $H:$P baglanti yok"; exit 1; }
un=$(timeout 20 ssh "${O[@]}" "$U@$H" 'uname -r' 2>/dev/null </dev/null | tr -d '\r')
if ! [[ $un =~ $UNAME_RE ]]; then log "DUR: uname tutmadi ($H:$P uname='${un:0:80}'); hicbir sey alinmadi"; exit 65; fi
# --- ana hat SSH sonu ---

{ echo "uname $un"; timeout 30 ssh "${O[@]}" "$U@$H" 'echo "boot $(cat /proc/sys/kernel/random/boot_id) up $(cut -d" " -f1 /proc/uptime)"' </dev/null 2>&1; } > "$D/kaynak.txt"
timeout 60 ssh "${O[@]}" "$U@$H" 'sudo -n ls -la --time-style=+%F_%T /sys/fs/pstore' </dev/null > "$D/ls.txt" 2>&1
timeout 120 ssh "${O[@]}" "$U@$H" 'sudo -n tar -C /sys/fs/pstore -cf - .' </dev/null > "$D/pstore.tar"; R=$?
[ $R -eq 0 ] || { log "DUR: tar alinamadi rc=$R"; exit 1; }
(cd "$D" && tar --no-same-owner --no-same-permissions -xf pstore.tar && find . -type f ! -name SHA256SUMS ! -name pstore.tar ! -name ls.txt ! -name kaynak.txt -print0 | sort -z | xargs -0 -r sha256sum > SHA256SUMS)
log "ana hat pstore (silinmedi) -> $D ($(grep -c . "$D/SHA256SUMS") dosya; $un)"
cat "$D/kaynak.txt" "$D/ls.txt" "$D/SHA256SUMS"
