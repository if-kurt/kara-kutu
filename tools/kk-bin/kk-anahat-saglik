#!/bin/bash
# Kara Kutu kk-bin (G57 G-8 önerisi): ana hat Debian'ında (SSH 2222) sağlık özeti. YALNIZ OKUMA.
#   kk-anahat-saglik                  onaylı cihaz/anahat-saglik.sh'ı `sudo -n sh -s` ile çalıştırır, raporu ve HUKUM'u basar
#   kk-anahat-saglik kayit <dosya>    ayrıca <dosya>'ya (work/ altında; yoksa açılır, varsa sonuna) TEK satır ekler
#                                     (G-1 uzun koşu izleme). Bu kipte 2222 kapalıysa (kilit hiç alınmadan) ya da kilit
#                                     doluysa kk-bin.log'a ve kilit dosyasına HİÇ YAZILMAZ (yalnız <dosya>'ya ERISIM-YOK /
#                                     KILIT-DOLU satırı): kk-fb-oluadam "son 20 dk'da kk-bin çağrısı yok" ölçütünü
#                                     kk-bin.log/kk-bin.kilit mtime'ından, "kk-bin çalışıyor"u kilitten okur; erişimsiz
#                                     yoklamalar ikisini de etkilememeli.
# Hedef SABİT: ${KK_KULLANICI:-kk}@172.16.42.1 port 2222, known_hosts_anahat; uname ^6\.12\.[0-9]+-kk-g[0-9]+$ aynı ana bağlantıda.
# Cihaz betiği sha SABİT; özel kopyada denetlenir, gönderilen o kopyadır (stdin; uzak komut yalnız `sudo -n sh -s`).
# HUKUM (ana makinede, betiğin son "OZET k=v" satırından): UYARI nedenleri = sistem != running, failed > 0, hata > 0
#   (Oops/SError/Call trace/BUG, lockup/panik/RCU stall, blok/A12 red, EXT4 hata/uyarı, I/O error; Ş12 süzgeçli), sigorta > 0,
#   wb > WB_AZAMI (Ş2, asıl 5), cmd2x > 0, d_io > 0, SP805 active değil, üst katman >= UST_AZAMI %, alan ro/dur,
#   pil >= PIL_AZAMI °C, SoC >= SOC_AZAMI °C (sigorta 45/70'in altı), sensör satırı yok, kipin zamanlayıcısı active değil.
#   G58: OZET'te kova= (G-1 kk-alan kova seviyesi, sektör) YALNIZ BİLGİ; UYARI sayılmaz, bulunamazsa "yok".
# Ölü adam (G58): bu araç kk-fb-oluadam'ın IZLEME listesinde; satırları ([kk-anahat-saglik]) "kk-bin sessizliği"ni bozmaz.
# Çıkış: 0 SAGLIKLI / 10 UYARI / 1 bağlantı yok (kayit: ERISIM-YOK) / 2 çıktı eksik (OZET yok) / 64 girdi /
#        65 uname tutmadı / 66 cihaz betiği sha / 77 kilit dolu. Log: work/kk-bin-log/kk-bin.log. Kurmak/değiştirmek bakımcı onayı.
# Ortak kk-bin kilidi (flock -n, work/kk-bin-log/kk-bin.kilit, fd 9); doluysa çıkış 77, hiçbir şey yapılmaz.
set -u
KB=/opt/kara-kutu/tools/kk-bin
S=$KB/cihaz/anahat-saglik.sh
SSHA=e0b9b41ce29e97a8437f51801648c92dc25a114b9d0a7fe2c9195a66ac3004e2
H=172.16.42.1; P=2222; U=${KK_KULLANICI:-kk}; SURE=120
UNAME_RE='^6\.12\.[0-9]+-kk-g[0-9]+$'
WB_AZAMI=5; UST_AZAMI=90; PIL_AZAMI=42; SOC_AZAMI=65
LOG=/opt/kara-kutu/work/kk-bin-log/kk-bin.log
log() { echo "$(date -u '+%F %T.%3N') UTC [kk-anahat-saglik] $*" | tee -a "$LOG" >&2; }
[ "$P" = 2222 ] || exit 70
KF=
case "$#:${1:-}" in
	0:) ;;
	2:kayit)
		KF=$(realpath -m -- "$2")
		case $KF in /opt/kara-kutu/work/?*) ;; *) echo "DUR: kayit dosyasi work/ disinda: $KF" >&2; exit 64;; esac
		[ -d "${KF%/*}" ] || { echo "DUR: dizin yok: ${KF%/*}" >&2; exit 64; }
		[ ! -e "$KF" ] || [ -f "$KF" ] || { echo "DUR: kayit dosyasi normal dosya degil: $KF" >&2; exit 64; };;
	*) echo "kullanim: kk-anahat-saglik [kayit <dosya>]" >&2; exit 64;;
esac
kyaz() { [ -n "$KF" ] && echo "$(date -u '+%F %T') UTC $*" >> "$KF"; return 0; }
KK_KILIT=/opt/kara-kutu/work/kk-bin-log/kk-bin.kilit
if [ -n "$KF" ]; then
	# --- kayit kipi: önce erişim yoklaması (yalnız TCP bağlantı denemesi; kilit ALINMAZ -> kk-fb-oluadam'ın 5 dk'lık turu
	#     "kilit dolu" görüp kalışı sıfırlamaz), sonra sessiz kilit. Erişim yok / kilit dolu: kk-bin.log ve kilit dosyası
	#     YAZILMAZ (mtime değişmez); yalnız <dosya>'ya satır. ---
	nc -z -w 2 "$H" "$P" 2>/dev/null || { kyaz "ERISIM-YOK $H:$P (kk-bin.log'a yazilmadi; kilit alinmadi)"; exit 1; }
	mkdir -p "${KK_KILIT%/*}" || exit 77
	if ! { [ /proc/$$/fd/9 -ef "$KK_KILIT" ] && flock -n 9; }; then
		{ exec 9>>"$KK_KILIT" && flock -n 9; } || { kyaz "KILIT-DOLU (kk-bin calisiyor; yoklama atlandi)"; exit 77; }
	fi
	export KK_KILIT_SAHIBI="pid=$$ ${0##*/}"
	printf 'pid=%s betik=%s arg=%.80s bas=%s UTC\n' $$ "${0##*/}" "$*" "$(date -u '+%F %T.%3N')" > "$KK_KILIT"
	echo "$(date -u '+%F %T.%3N') UTC [${0##*/}] kilit: alindi (pid $$; kayit kipi, 2222 acik)" >> "${KK_KILIT%/*}/kk-bin.log"
else
# --- G49 ortak kilit (kural 17'nin mekanik karşılığı): cihaza dokunan kk-bin çağrıları tek tek. ---
# flock, work/kk-bin-log/kk-bin.kilit üzerinde, fd 9. Bekleme YOK (-n): kilit doluysa hemen 77, cihaz işlemi yapılmaz.
# Miras: iç içe kk-bin çağrısı üstünün fd 9'unu (aynı açık dosya tanımı) devralır; flock aynı tanımda yeniden başarılı.
# Ortam değişkeni (KK_KILIT_SAHIBI) yalnız log içindir; mirası açmaz. Kilidi tutan süreç ve fd 9'u devralan çocukları
# bitince (SIGKILL dahil) çekirdek kilidi bırakır: bayat kilit olmaz (dosya kalır, içeriği yalnız "son sahip" bilgisi).
KK_KILIT=/opt/kara-kutu/work/kk-bin-log/kk-bin.kilit
kk_kilit() {
	local kl=${KK_KILIT%/*}/kk-bin.log ad=${0##*/} t
	t=$(date -u '+%F %T.%3N')
	mkdir -p "${KK_KILIT%/*}" || exit 77
	if [ /proc/$$/fd/9 -ef "$KK_KILIT" ] && flock -n 9; then
		echo "$t UTC [$ad] kilit: miras (sahip ${KK_KILIT_SAHIBI:-?}; pid $$)" >> "$kl"; return 0
	fi
	if exec 9>>"$KK_KILIT" && flock -n 9; then
		export KK_KILIT_SAHIBI="pid=$$ $ad"
		printf 'pid=%s betik=%s arg=%.80s bas=%s UTC\n' $$ "$ad" "$*" "$t" > "$KK_KILIT"
		echo "$t UTC [$ad] kilit: alindi (pid $$)" >> "$kl"; return 0
	fi
	echo "$t UTC [$ad] RED: kk-bin kilidi mesgul (son sahip: $(head -c 200 "$KK_KILIT" 2>/dev/null | tr -d '\n')); cihaz islemi YAPILMADI; cikis 77" | tee -a "$kl" >&2
	exit 77
}
kk_kilit "$@"
# --- G49 ortak kilit sonu ---
fi

# --- G57 G-8 ana hat SSH (kk-anahat-ssh ile aynı seçenekler; tek ana bağlantı, uname aynı bağlantıda) ---
T=$(mktemp -d) || exit 70
O=(-p "$P" -o UserKnownHostsFile="$KB/known_hosts_anahat" -o StrictHostKeyChecking=yes -o BatchMode=yes
   -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 -S "$T/s")
bitir() { [ -S "$T/s" ] && ssh "${O[@]}" -O exit "$U@$H" >/dev/null 2>&1 </dev/null; rm -f -- "$T/s" "$T/b" "$T/c"; rmdir -- "$T" 2>/dev/null; }
trap bitir EXIT
cp -- "$S" "$T/b" 2>/dev/null && [ "$(sha256sum "$T/b" | cut -c1-64)" = "$SSHA" ] || { log "DUR: cihaz betigi $S sha'si beklenen degil; gonderilmedi"; kyaz "BETIK-SHA"; exit 66; }
timeout 20 ssh "${O[@]}" -M -fN "$U@$H" 9>&- 2>/dev/null </dev/null || { log "DUR: $H:$P baglanti yok"; kyaz "ERISIM-YOK $H:$P (ssh)"; exit 1; }
un=$(timeout 20 ssh "${O[@]}" "$U@$H" 'uname -r' 2>/dev/null </dev/null | tr -d '\r')
if ! [[ $un =~ $UNAME_RE ]]; then log "DUR: uname tutmadi ($H:$P uname='${un:0:80}'); betik GONDERILMEDI"; kyaz "UNAME-TUTMADI '${un:0:40}'"; exit 65; fi
# --- ana hat SSH sonu ---

timeout "$SURE" ssh "${O[@]}" "$U@$H" 'sudo -n sh -s' < "$T/b" > "$T/c" 2>&1; R=$?
cat "$T/c"
oz=$(grep '^OZET ' "$T/c" | tail -n 1)
if [ -z "$oz" ]; then log "UYARI: cikti eksik (OZET yok; rc=$R)"; kyaz "EKSIK rc=$R $un"; exit 2; fi
al() { sed -n "s/.* $1=\([^ ]*\).*/\1/p" <<<"$oz"; }
sayi() { [[ ${1:-} =~ ^[0-9]+$ ]]; }
esik() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 >= b + 0) }'; }	# a >= b (ondalıklı)
N=()
[ "$(al sistem)" = running ] || N+=("sistem=$(al sistem)")
for k in failed hata sigorta cmd2x d_io; do v=$(al $k); sayi "$v" || { N+=("$k=?"); continue; }; [ "$v" -eq 0 ] || N+=("$k=$v"); done
v=$(al wb); if sayi "$v"; then [ "$v" -le $WB_AZAMI ] || N+=("wb=$v>$WB_AZAMI"); else N+=("wb=?"); fi
[ "$(al wd)" = active ] || N+=("wd=$(al wd)")
v=$(al ust); if sayi "$v"; then [ "$v" -lt $UST_AZAMI ] || N+=("ust=$v%"); else N+=("ust=?"); fi
case $(al alan) in ro|dur) N+=("alan=$(al alan)");; esac
v=$(al pil_c); if [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]]; then esik "$v" $PIL_AZAMI && N+=("pil_c=$v"); else N+=("sensor-yok"); fi
v=$(al soc_c); if [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]]; then esik "$v" $SOC_AZAMI && N+=("soc_c=$v"); fi
case $(al kip) in
	gunluk) [ "$(al saglik_timer)" = active ] || N+=("saglik_timer=$(al saglik_timer)");;
	sinir) [ "$(al sinir_timer)" = active ] || N+=("sinir_timer=$(al sinir_timer)");;
	*) N+=("kip=?");;
esac
if [ ${#N[@]} -eq 0 ]; then HK=SAGLIKLI; rc=0; else HK="UYARI($(IFS=,; echo "${N[*]}"))"; rc=10; fi
echo "HUKUM: $HK"
log "saglik $un HUKUM=$HK ${oz:5:240}"
kyaz "HUKUM=$HK ${oz#OZET }"
exit $rc
