#!/bin/bash
# Kara Kutu kk-bin (G33): ana hat Debian'ında (6.12 + salt okunur overlay) SSH ile TEK bir komut çalıştır.
#   kk-anahat-ssh '<komut>'
# Hedef SABİT: ${KK_KULLANICI:-kk}@172.16.42.1 port 2222 (ana hat Debian'ın sshd'si yalnız 2222'de; 4.9 Debian 22'de, kurtarma
# telnet 23'te; bu betik ikisine de bağlanmaz).
# Doğrulama (komuttan ÖNCE): tek bir SSH ana bağlantısı (ControlMaster) açılır; aynı bağlantı üzerinden `uname -r`
#   okunur; ^6\.12\.[0-9]+-kk-g[0-9]+$ değilse komut ÇALIŞTIRILMAZ (65). Komut da aynı bağlantı üzerinden çalışır.
#   G33 (bakımcı onayı): görev numarasına bağlı değil; QEMU "q" varyantı ve 4.9 (4.9.x) eşleşmez.
# Host anahtarı: known_hosts_anahat ([172.16.42.1]:2222; cihaz Debian'ının anahtarı, 4.9 ile aynı dosyadan).
# Komut: tek satır, 1-1000 karakter, denetim karakteri yok. Süre en çok 300 sn.
# Çıkış: komut rc / 1 bağlantı yok / 65 uname tutmadı (çalıştırılmadı) / 64 girdi / 255 bağlantı koptu (ör. reboot).
# Log: /opt/kara-kutu/work/kk-bin-log/kk-bin.log. Değiştirmek bakımcının onayını gerektirir (docs/guvenlik-tasarimi.md).
# G50 (bakımcı onayı (i), G49 önerisi): ortak kk-bin kilidi (flock -n, work/kk-bin-log/kk-bin.kilit, fd 9); doluysa çıkış 77, hiçbir şey yapılmaz.
set -u
KB=/opt/kara-kutu/tools/kk-bin
H=172.16.42.1; P=2222; U=${KK_KULLANICI:-kk}; SURE=300
UNAME_RE='^6\.12\.[0-9]+-kk-g[0-9]+$'
LOG=/opt/kara-kutu/work/kk-bin-log/kk-bin.log; mkdir -p "${LOG%/*}"
log() { echo "$(date -u '+%F %T.%3N') UTC [kk-anahat-ssh] $*" | tee -a "$LOG" >&2; }
[ "$P" = 2222 ] || exit 70
[ $# -eq 1 ] || { echo "kullanim: kk-anahat-ssh '<komut>'" >&2; exit 64; }
CMD=$1
[ ${#CMD} -ge 1 ] && [ ${#CMD} -le 1000 ] || { log "DUR: komut uzunlugu ${#CMD}"; exit 64; }
[[ $CMD =~ [[:cntrl:]] ]] && { log "DUR: komutta denetim karakteri/satir sonu var"; exit 64; }
# --- G49 ortak kilit (kural 17'nin mekanik karşılığı): cihaza dokunan kk-bin çağrıları tek tek. ---
# flock, work/kk-bin-log/kk-bin.kilit üzerinde, fd 9. Bekleme YOK (-n): kilit doluysa hemen 77, cihaz işlemi yapılmaz.
# Miras: iç içe kk-bin çağrısı üstünün fd 9'unu (aynı açık dosya tanımı) devralır; flock aynı tanımda yeniden başarılı.
# Ortam değişkeni (KK_KILIT_SAHIBI) yalnız log içindir; mirası açmaz. Kilidi tutan süreç ve fd 9'u devralan çocukları
# bitince (SIGKILL dahil) çekirdek kilidi bırakır: bayat kilit olmaz (dosya kalır, içeriği yalnız "son sahip" bilgisi).
KK_KILIT=/opt/kara-kutu/work/kk-bin-log/kk-bin.kilit
kk_kilit() {
	local kl=${KK_KILIT%/*}/kk-bin.log ad=${0##*/} t
	t=$(date -u '+%F %T.%3N')
	mkdir -p "${KK_KILIT%/*}" || exit 77
	if [ /proc/$$/fd/9 -ef "$KK_KILIT" ] && flock -n 9; then
		echo "$t UTC [$ad] kilit: miras (sahip ${KK_KILIT_SAHIBI:-?}; pid $$)" >> "$kl"; return 0
	fi
	if exec 9>>"$KK_KILIT" && flock -n 9; then
		export KK_KILIT_SAHIBI="pid=$$ $ad"
		printf 'pid=%s betik=%s arg=%.80s bas=%s UTC\n' $$ "$ad" "$*" "$t" > "$KK_KILIT"
		echo "$t UTC [$ad] kilit: alindi (pid $$)" >> "$kl"; return 0
	fi
	echo "$t UTC [$ad] RED: kk-bin kilidi mesgul (son sahip: $(head -c 200 "$KK_KILIT" 2>/dev/null | tr -d '\n')); cihaz islemi YAPILMADI; cikis 77" | tee -a "$kl" >&2
	exit 77
}
kk_kilit "$@"
# --- G49 ortak kilit sonu ---

T=$(mktemp -d) || exit 70
O=(-p "$P" -o UserKnownHostsFile="$KB/known_hosts_anahat" -o StrictHostKeyChecking=yes -o BatchMode=yes
   -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 -S "$T/s")
bitir() { ssh "${O[@]}" -O exit "$U@$H" >/dev/null 2>&1; rm -f -- "$T/s"; rmdir -- "$T" 2>/dev/null; }
trap bitir EXIT

# 1) ana bağlantı + uname doğrulaması
timeout 20 ssh "${O[@]}" -M -fN "$U@$H" 9>&- 2>/dev/null || { log "DUR: $H:$P baglanti yok"; exit 1; }
un=$(timeout 20 ssh "${O[@]}" "$U@$H" 'uname -r' 2>/dev/null | tr -d '\r')
if ! [[ $un =~ $UNAME_RE ]]; then
	log "DUR: uname tutmadi ($H:$P uname='${un:0:80}'); komut CALISTIRILMADI"
	exit 65
fi
log "uname OK: $H:$P $un; komut: $CMD"

# 2) komut (aynı ana bağlantı üzerinden)
timeout "$SURE" ssh "${O[@]}" "$U@$H" "$CMD"; rc=$?
case $rc in
	124) log "UYARI: zaman asimi (${SURE}s)";;
	255) log "baglanti koptu (rc=255; reboot komutu olabilir)";;
	*) log "bitti rc=$rc";;
esac
exit "$rc"
