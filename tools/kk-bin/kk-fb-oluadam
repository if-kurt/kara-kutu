#!/bin/bash
# Kara Kutu kk-bin (G56; G58 izleme ayrımı): fastboot ölü adam dönüşü. kullanıcı crontab'ından 5 dk'da bir; argümansız. bakımcı onayı 2026-11-21: "Evet, kur".
# Kural: cihaz (<CIHAZ_SERI>) ESIK sn (1200) KESİNTİSİZ fastboot'ta VE son ESIK sn'de İZLEME DIŞI hiçbir kk-bin çağrısı yoksa
#   -> kk-v51-don (bir kez). Çıktısı kk-bin.log'a (kk-v51-don'un kendi log'u) ve bu betiğin log'una.
# G58 (tasarım): IZLEME araçları (salt okuma: kk-anahat-saglik, kk-anahat-olcum, kk-anahat-pstore-al) sessizliği BOZMAZ.
#   kk-anahat-ssh izleme DEĞİLDİR (reboot da gönderir). Sessizlik = en yeni şu ikisi:
#   (i) kk-bin.log'un son 1 MiB'ı (ilk, kesik olabilecek satır atlanır): [ad] etiketi IZLEME'de olmayan zaman damgalı satırların
#       en yenisi. Zaman damgasız satır (fastboot/kk-izle çıktısı; hep izleme dışı) kendinden sonraki ilk zaman damgalı satırın
#       zamanını, dosya sonundaysa log mtime'ını alır. Pencerede izleme dışı satır yoksa pencerenin en eski zaman damgası; hiç
#       zaman damgalı satır yoksa log mtime'ı (ikisi de tutucu: gerçek zamandan yeni ya da eşit).
#   (ii) kk-bin.kilit mtime'ı; son sahip (içerikteki betik=) IZLEME'de ise sayılmaz (izleme aracı kilidi alırken yazar).
#   Belirsizlik hep izleme dışı yönüne (bekle) çözülür: bir izleme çağrısı eylemi en çok bir tur geciktirir, gerektiği hâlde
#   eylemi engellemez.
# Kalış: ardışık iki tur arası (gözlem ya da izleme-kilidi turu) > BOSLUK sn (600) ise kalış yeniden başlar. Cihaz fastboot'ta
#   GÖRÜLMEYİNCE kalış biter ve deneme hakkı yenilenir (yalnız bu yenilemez: kilit dolu / takılma / kapatma kalışı sıfırlar ama
#   hakkı geri vermez).
# Sınırlar: her fastboot kalışında en çok 1 deneme (başarısızsa tekrar yok); 24 saatte en çok SINIR24 (2) deneme (saat geri
#   gitmişse = kayıt gelecekte -> deneme yok).
# Kilit: ortak kk-bin kilidi (work/kk-bin-log/kk-bin.kilit, fd 9, flock -n) kk_kilit ÇAĞRILMADAN alınır (kk-bin.log'a rutin satır
#   YAZILMAZ; yoksa "kk-bin çağrılmadı" ölçütü hiç dolmaz). Kilit doluysa:
#   - sahibi CANLI bir IZLEME aracıysa (içerikteki pid yaşıyor, argv'sinde o ad var): kalış KORUNUR; bu tur gözlem ve eylem YOK
#     (kk-v51-don 77 alırdı) -> sonraki tur. Tur zamanı .atla'ya yazılır (boşluk ölçütü için);
#   - aksi hâlde (izleme dışı sahip, okunamayan içerik, ölü pid) = kk-bin çalışıyor -> kalış sıfırlanır (G56 davranışı).
#   Eylemde kk-v51-don fd 9'u miras alır (kk_kilit "miras" satırı). Kendi eşzamanlılık kilidi: fd 8 (.durum.kilit).
# Algılama YALNIZ `timeout 10 fastboot devices` (kural 5; başka fastboot komutu yok), yalnız kilit alınmışken; çocuklar fd 8/9'u
#   devralmaz.
# Rutin kararlar yalnız kk-fb-oluadam.log'a. Kapatma: work/kk-bin-log/kk-fb-oluadam.kapali.
# Çıkış hep 0 (cron). Değiştirmek bakımcının onayını gerektirir.
set -u
# --- SABITLER (ortam değişkeniyle yol/eşik değiştirme kapısı YOK) ---
PATH=/usr/local/bin:/usr/bin:/bin
KB=/opt/kara-kutu/tools/kk-bin
V51=$KB/kk-v51-don
SERI=${KK_SERI:?KK_SERI ortam degiskeni (fastboot seri no) gerekli}
LD=/opt/kara-kutu/work/kk-bin-log
KK_KILIT=$LD/kk-bin.kilit
KKLOG=$LD/kk-bin.log
OLOG=$LD/kk-fb-oluadam.log
DURUM=$LD/kk-fb-oluadam.durum
DENEME=$LD/kk-fb-oluadam.denemeler
KAPALI=$LD/kk-fb-oluadam.kapali
ATLA=$LD/kk-fb-oluadam.atla
IZLEME=' kk-anahat-saglik kk-anahat-olcum kk-anahat-pstore-al '
# --- SABITLER SONU ---
ESIK=1200; BOSLUK=600; SINIR24=2; PENCERE=1048576

[ $# -eq 0 ] || { echo "kullanim: kk-fb-oluadam (argumansiz; cron)" >&2; exit 64; }
mkdir -p "$LD" || exit 0
log() { echo "$(date -u '+%F %T') UTC [kk-fb-oluadam] $*" >> "$OLOG"; }
sayi() { case ${1:-} in ''|*[!0-9]*) return 1;; esac; [ ${#1} -le 12 ]; }
izleme_adi() { case $IZLEME in *" ${1:-.} "*) return 0;; esac; return 1; }
kilit_betik() { sed -n '1s/^pid=[0-9]* betik=\([^ ]*\) .*/\1/p' "$KK_KILIT" 2>/dev/null | head -c 64; }
izleme_sahibi() {	# kilidi tutan canlı bir IZLEME aracı mı? (içerik "pid=N betik=AD ..."; /proc/N/cmdline'da .../AD)
	local l p ad a
	l=$(head -n 1 "$KK_KILIT" 2>/dev/null | head -c 200)
	[[ $l =~ ^pid=([0-9]{1,9})\ betik=([^ ]+)\  ]] || return 1
	p=${BASH_REMATCH[1]}; ad=${BASH_REMATCH[2]}
	izleme_adi "$ad" || return 1
	[ -r "/proc/$p/cmdline" ] || return 1
	while IFS= read -r -d '' a; do [ "${a##*/}" = "$ad" ] && return 0; done < "/proc/$p/cmdline"
	return 1
}
if [ -f "$OLOG" ] && [ "$(stat -c %s "$OLOG" 2>/dev/null || echo 0)" -gt 2097152 ]; then mv -f "$OLOG" "$OLOG.1"; fi

# 1) Kendi eşzamanlılık kilidi (önceki çalışma, ör. kk-v51-don sürüyorsa hiçbir şeye dokunmadan çık).
exec 8>>"$DURUM.kilit" && flock -n 8 || { log "onceki calisma suruyor; cikis"; exit 0; }

now=$(date +%s); sayi "$now" || { log "HATA: saat okunamadi"; exit 0; }
# 2) Durum: "kalis_bas son_gozlem denendi son_calisma" (G56 biçimi aynen) + .atla: son izleme-kilidi turu
kb=0; sg=0; dn=0
if [ -e "$DURUM" ]; then
	read -r a b c _ x < "$DURUM" 2>/dev/null
	if sayi "${a:-}" && sayi "${b:-}" && { [ "${c:-}" = 0 ] || [ "${c:-}" = 1 ]; } && [ -z "${x:-}" ]; then kb=$a; sg=$b; dn=$c
	else log "UYARI: durum bozuk; kalis sifirlandi, bu kalista deneme YOK sayildi (tutucu)"; kb=0; sg=0; dn=1; fi
fi
kaydet() { printf '%s %s %s %s\n' "$kb" "$sg" "$dn" "$now" > "$DURUM.tmp" && mv -f "$DURUM.tmp" "$DURUM"; }
if [ "$kb" -gt "$now" ] || [ "$sg" -gt "$now" ]; then log "UYARI: saat geri gitmis (durum > simdi); kalis sifirlandi"; kb=0; sg=0; fi
sa=0
if [ -e "$ATLA" ]; then
	read -r y x < "$ATLA" 2>/dev/null
	if sayi "${y:-}" && [ -z "${x:-}" ] && [ "$y" -le "$now" ]; then sa=$y; else log "UYARI: atla kaydi bozuk/ileri; yok sayildi (bosluk son gozlemden)"; fi
fi
ref=$sg; [ "$sa" -gt "$ref" ] && ref=$sa	# son tur (gözlem ya da izleme-kilidi turu)

# 3) Kapatma
if [ -e "$KAPALI" ]; then
	[ "$kb" -gt 0 ] && log "KAPALI ($KAPALI var): kalis sifirlandi"
	kb=0; kaydet; exit 0
fi

# 4) Ortak kk-bin kilidi (kk_kilit çağrılmaz; kk-bin.log'a yazılmaz)
if ! { exec 9>>"$KK_KILIT" && flock -n 9; }; then
	sh=$(head -c 120 "$KK_KILIT" 2>/dev/null | tr -d '\n')
	if izleme_sahibi; then
		if [ "$kb" -gt 0 ] && [ $((now - ref)) -gt "$BOSLUK" ]; then
			log "kk-bin kilidi izleme aracinda (sahip: $sh); tur boslugu $((now - ref)) sn > $BOSLUK: kalis sifirlandi"; kb=0; kaydet
		elif [ "$kb" -gt 0 ]; then
			log "kk-bin kilidi izleme aracinda (sahip: $sh): kalis korunuyor ($((now - kb)) sn); gozlem/eylem yok, sonraki tur"
		else
			log "kk-bin kilidi izleme aracinda (sahip: $sh): kalis yok; gozlem yok, sonraki tur"
		fi
		echo "$now" > "$ATLA.tmp" && mv -f "$ATLA.tmp" "$ATLA"
		exit 0
	fi
	log "kk-bin kilidi dolu (kk-bin calisiyor; sahip: $sh): kalis sifirlandi"
	kb=0; kaydet; exit 0
fi

# 5) Algılama: yalnız fastboot devices (zaman aşımlı; fd 8/9 çocuğa geçmez)
out=$(timeout -k 2 10 fastboot devices 2>/dev/null 8>&- 9>&-); r=$?
if [ $r -ne 0 ]; then
	log "fastboot devices basarisiz/takildi (rc=$r): belirsiz, kalis sifirlandi"; kb=0; kaydet; exit 0
fi
if ! printf '%s\n' "$out" | grep -qE "^$SERI[[:space:]]+fastboot([[:space:]]|\$)"; then
	{ [ "$kb" -gt 0 ] || [ "$dn" = 1 ]; } && log "cihaz fastboot'ta degil: kalis bitti (deneme hakki yenilendi)"
	kb=0; sg=0; dn=0; kaydet; exit 0
fi

# 6) Fastboot'ta
if [ "$kb" -eq 0 ]; then kb=$now; log "fastboot kalisi basladi"
elif [ $((now - ref)) -gt "$BOSLUK" ]; then log "tur boslugu $((now - ref)) sn > $BOSLUK: kalis yeniden basliyor"; kb=$now; fi
sg=$now; kaydet
sure=$((now - kb))
# Son İZLEME DIŞI kk-bin zamanı (mt) ve kaynağı
mt=0; kay=yok
en_yeni() { sayi "${1:-}" && [ "$1" -gt "$mt" ] && { mt=$1; kay=$2; }; return 0; }
lm=$(stat -c %Y "$KKLOG" 2>/dev/null)
s=$(tail -c "$PENCERE" "$KKLOG" 2>/dev/null 8>&- 9>&- | awk -v iz="$IZLEME" '
	NR == 1 { next }
	/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9](\.[0-9]+)? UTC \[[^] ]+\]/ {
		t = substr($0, 1, 19); a = $0; sub(/^[^[]*\[/, "", a); sub(/\].*$/, "", a)
		if (ilk == "" || t < ilk) ilk = t
		if (bek || index(iz, " " a " ") == 0) { if (t > son) son = t }
		bek = 0; next
	}
	{ bek = 1 }
	END { if (bek) print "SON-DAMGASIZ"; else if (son != "") print son " satir"; else if (ilk != "") print ilk " pencere-basi"; else print "YOK" }' 8>&- 9>&-)
case $s in
	*" satir"|*" pencere-basi")
		e=$(date -u -d "${s% *}" +%s 2>/dev/null)
		if sayi "$e"; then en_yeni "$e" "log-${s##* }"; else en_yeni "$lm" log-mtime; fi;;
	*) en_yeni "$lm" log-mtime;;
esac
ka=$(kilit_betik)
izleme_adi "$ka" || en_yeni "$(stat -c %Y "$KK_KILIT" 2>/dev/null)" "kilit(${ka:-?})"
yas=$((now - mt))
[ "$sure" -ge "$ESIK" ] || { log "fastboot'ta ${sure}/${ESIK} sn; son izleme disi kk-bin ${yas} sn once ($kay); bekle"; exit 0; }
[ "$yas" -ge "$ESIK" ] || { log "fastboot'ta ${sure} sn ama son izleme disi kk-bin ${yas} sn once ($kay; < $ESIK); bekle"; exit 0; }
[ "$dn" = 0 ] || { log "fastboot'ta ${sure} sn; bu kalista deneme yapildi: tekrar YOK (elle mudahale gerekir)"; exit 0; }
n24=0; ileri=0; bozuk=0
if [ -e "$DENEME" ]; then
	while read -r e x; do
		sayi "${e:-}" && [ -z "${x:-}" ] || { bozuk=1; continue; }
		[ "$e" -gt $((now + 60)) ] && ileri=1
		[ $((now - e)) -lt 86400 ] && n24=$((n24 + 1))
	done < "$DENEME"
fi
[ "$bozuk" = 0 ] || { log "SINIR: deneme kaydi bozuk ($DENEME); deneme YOK (elle duzeltilmeli)"; exit 0; }
[ "$ileri" = 0 ] || { log "SINIR: saat geri gitmis (deneme kaydi > simdi); deneme YOK"; exit 0; }
[ "$n24" -lt "$SINIR24" ] || { log "SINIR: 24 saatte $n24 deneme (en cok $SINIR24); deneme YOK"; exit 0; }

# 7) EYLEM: önce kayıt (bu kalış denendi + 24 s listesi), sonra kk-v51-don (fd 9 miras).
dn=1; kaydet; echo "$now" >> "$DENEME"; sync
log "EYLEM: fastboot'ta ${sure} sn, son izleme disi kk-bin ${yas} sn once ($kay), 24s=$n24 -> kk-v51-don"
echo "$(date -u '+%F %T.%3N') UTC [kk-fb-oluadam] EYLEM: ${sure} sn fastboot, ${yas} sn izleme disi kk-bin yok -> kk-v51-don (cron, tek deneme)" >> "$KKLOG"
export KK_KILIT_SAHIBI="pid=$$ kk-fb-oluadam"
"$V51" >> "$OLOG" 2>&1 8>&-; r=$?
log "kk-v51-don cikis=$r (0 v5.1 dogrulandi; 1 flash yok; 2 Debian gelmedi; 3 sha tutmadi; 77 kilit)"
echo "$(date -u '+%F %T.%3N') UTC [kk-fb-oluadam] kk-v51-don cikis=$r" >> "$KKLOG"
exit 0
